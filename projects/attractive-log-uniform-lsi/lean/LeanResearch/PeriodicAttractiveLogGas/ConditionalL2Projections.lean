import LeanResearch.PeriodicAttractiveLogGas.EntropyL2
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic
import Mathlib.Probability.CondVar
import Mathlib.Analysis.InnerProductSpace.Positive
import Mathlib.Tactic.Abel
import Mathlib.Tactic.Ring

/-! The conditional-expectation Hilbert-space
identities in source Lemma 3.7, lines 651–672. The maps below are the genuine
Mathlib L2 conditional expectations, included back into the ambient real
L2 space. No projection, variance identity or spectral gap is assumed.

The last section constructs the actual sigma-algebras generated by all
coordinates except one. Identifying a separately constructed pointwise
conditional kernel with these maps is a further application bridge.
-/

noncomputable section
open MeasureTheory Filter Set
open scoped ENNReal NNReal InnerProductSpace BigOperators

namespace PeriodicAttractiveLogGas.ConditionalL2Projections

/- The ambient structure is inferred from the actual measure. The explicit
smaller sigma-algebra must not replace it during instance synthesis. -/
variable {α : Type*} {m₀ : MeasurableSpace α} (μ : Measure[m₀] α)

/-- Actual L2 conditional expectation, with codomain the ambient L2 space. -/
def projection (m : MeasurableSpace α) (hm : m ≤ m₀) :
    Lp ℝ 2 μ →L[ℝ] Lp ℝ 2 μ :=
  (@lpMeas α ℝ ℝ _ _ _ m m₀ 2 μ).subtypeL.comp (condExpL2 ℝ ℝ hm)

theorem projection_apply (m : MeasurableSpace α) (hm : m ≤ m₀) (f : Lp ℝ 2 μ) :
    projection μ m hm f = (condExpL2 ℝ ℝ hm f : Lp ℝ 2 μ) := rfl

/-- This is the actual orthogonal projection onto the measurable L2 subspace. -/
theorem projection_eq_starProjection (m : MeasurableSpace α) [Fact (m ≤ m₀)] :
    projection μ m Fact.out = (@lpMeas α ℝ ℝ _ _ _ m m₀ 2 μ).starProjection := rfl

theorem projection_mem (m : MeasurableSpace α) (hm : m ≤ m₀) (f : Lp ℝ 2 μ) :
    projection μ m hm f ∈ @lpMeas α ℝ ℝ _ _ _ m m₀ 2 μ :=
  (condExpL2 ℝ ℝ hm f).property

theorem projection_aestronglyMeasurable (m : MeasurableSpace α) (hm : m ≤ m₀)
    (f : Lp ℝ 2 μ) : AEStronglyMeasurable[m] (projection μ m hm f) μ :=
  aestronglyMeasurable_condExpL2 hm f

theorem projection_eq_self_of_aestronglyMeasurable (m : MeasurableSpace α)
    (hm : m ≤ m₀) (f : Lp ℝ 2 μ) (hf : AEStronglyMeasurable[m] f μ) :
    projection μ m hm f = f := by
  let hle : Fact (m ≤ m₀) := ⟨hm⟩
  change (@lpMeas α ℝ ℝ _ _ _ m m₀ 2 μ).starProjection f = f
  exact Submodule.starProjection_eq_self_iff.mpr
    (mem_lpMeas_iff_aestronglyMeasurable.mpr hf)

theorem projection_eq_self_iff (m : MeasurableSpace α) (hm : m ≤ m₀) (f : Lp ℝ 2 μ) :
    projection μ m hm f = f ↔ AEStronglyMeasurable[m] f μ := by
  constructor
  · intro hf
    rw [← hf]
    exact projection_aestronglyMeasurable μ m hm f
  · exact projection_eq_self_of_aestronglyMeasurable μ m hm f

theorem projection_idempotent (m : MeasurableSpace α) (hm : m ≤ m₀) (f : Lp ℝ 2 μ) :
    projection μ m hm (projection μ m hm f) = projection μ m hm f :=
  projection_eq_self_of_aestronglyMeasurable μ m hm _
    (projection_aestronglyMeasurable μ m hm f)

theorem projection_isIdempotentElem (m : MeasurableSpace α) (hm : m ≤ m₀) :
    IsIdempotentElem (projection μ m hm) := by
  apply ContinuousLinearMap.ext
  intro f
  exact projection_idempotent μ m hm f

theorem projection_range (m : MeasurableSpace α) (hm : m ≤ m₀) :
    (projection μ m hm).range = @lpMeas α ℝ ℝ _ _ _ m m₀ 2 μ := by
  let hle : Fact (m ≤ m₀) := ⟨hm⟩
  change (@lpMeas α ℝ ℝ _ _ _ m m₀ 2 μ).starProjection.range =
    @lpMeas α ℝ ℝ _ _ _ m m₀ 2 μ
  exact Submodule.range_starProjection _

theorem projection_isSymmetricProjection (m : MeasurableSpace α) (hm : m ≤ m₀) :
    (projection μ m hm).IsSymmetricProjection := by
  let hle : Fact (m ≤ m₀) := ⟨hm⟩
  change (@lpMeas α ℝ ℝ _ _ _ m m₀ 2 μ).starProjection.IsSymmetricProjection
  exact Submodule.isSymmetricProjection_starProjection _

theorem projection_inner_symm (m : MeasurableSpace α) (hm : m ≤ m₀)
    (f g : Lp ℝ 2 μ) :
    ⟪projection μ m hm f, g⟫_ℝ = ⟪f, projection μ m hm g⟫_ℝ :=
  inner_condExpL2_left_eq_right hm

theorem projection_isSelfAdjoint (m : MeasurableSpace α) (hm : m ≤ m₀) :
    IsSelfAdjoint (projection μ m hm) :=
  ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr (projection_inner_symm μ m hm)

theorem projection_residual_orthogonal (m : MeasurableSpace α) (hm : m ≤ m₀)
    (f g : Lp ℝ 2 μ) (hg : AEStronglyMeasurable[m] g μ) :
    ⟪f - projection μ m hm f, g⟫_ℝ = 0 := by
  have h : ⟪projection μ m hm f, g⟫_ℝ = ⟪f, g⟫_ℝ :=
    inner_condExpL2_eq_inner_fun hm f g hg
  rw [inner_sub_left, h, sub_self]

theorem projection_inner_self (m : MeasurableSpace α) (hm : m ≤ m₀) (f : Lp ℝ 2 μ) :
    ⟪f, projection μ m hm f⟫_ℝ = ‖projection μ m hm f‖ ^ 2 := by
  have h : ⟪projection μ m hm f, projection μ m hm f⟫_ℝ =
      ⟪f, projection μ m hm f⟫_ℝ :=
    inner_condExpL2_eq_inner_fun hm f _ (projection_aestronglyMeasurable μ m hm f)
  rw [real_inner_self_eq_norm_sq] at h
  exact h.symm

theorem projection_norm_sub_sq (m : MeasurableSpace α) (hm : m ≤ m₀) (f : Lp ℝ 2 μ) :
    ‖f - projection μ m hm f‖ ^ 2 = ‖f‖ ^ 2 - ‖projection μ m hm f‖ ^ 2 := by
  rw [norm_sub_sq_real, projection_inner_self]
  ring

theorem projection_defect_quadratic (m : MeasurableSpace α) (hm : m ≤ m₀)
    (f : Lp ℝ 2 μ) :
    ⟪f, f - projection μ m hm f⟫_ℝ = ‖f - projection μ m hm f‖ ^ 2 := by
  rw [inner_sub_right, real_inner_self_eq_norm_sq, projection_inner_self,
    projection_norm_sub_sq]

theorem projection_isPositive (m : MeasurableSpace α) (hm : m ≤ m₀) :
    (projection μ m hm).IsPositive := by
  apply (ContinuousLinearMap.isPositive_iff' _).mpr
  refine ⟨projection_isSelfAdjoint μ m hm, ?_⟩
  intro f
  rw [real_inner_comm f (projection μ m hm f), projection_inner_self]
  exact sq_nonneg _

theorem one_sub_projection_isPositive (m : MeasurableSpace α) (hm : m ≤ m₀) :
    (1 - projection μ m hm).IsPositive := by
  apply (ContinuousLinearMap.isPositive_iff _).mpr
  constructor
  · intro f g
    change ⟪f - projection μ m hm f, g⟫_ℝ = ⟪f, g - projection μ m hm g⟫_ℝ
    rw [inner_sub_left, inner_sub_right, projection_inner_symm]
  · intro f
    change 0 ≤ ⟪f - projection μ m hm f, f⟫_ℝ
    rw [real_inner_comm f (f - projection μ m hm f), projection_defect_quadratic]
    exact sq_nonneg _

theorem norm_projection_le (m : MeasurableSpace α) (hm : m ≤ m₀) (f : Lp ℝ 2 μ) :
    ‖projection μ m hm f‖ ≤ ‖f‖ := norm_condExpL2_coe_le hm f

theorem projection_opNorm_le_one (m : MeasurableSpace α) (hm : m ≤ m₀) :
    ‖projection μ m hm‖ ≤ 1 := by
  apply (projection μ m hm).opNorm_le_bound zero_le_one
  intro f
  simpa only [one_mul] using norm_projection_le μ m hm f

theorem integrable_projection_deviation_sq (m : MeasurableSpace α) (hm : m ≤ m₀)
    (f : Lp ℝ 2 μ) : Integrable (fun x ↦ (f x - projection μ m hm f x) ^ 2) μ := by
  have hi : Integrable (fun x ↦ ((f - projection μ m hm f) x) ^ 2) μ :=
    (memLp_two_iff_integrable_sq (Lp.aestronglyMeasurable _)).mp (Lp.memLp _)
  apply hi.congr
  filter_upwards [Lp.coeFn_sub f (projection μ m hm f)] with x hx
  change (f - projection μ m hm f) x = f x - projection μ m hm f x at hx
  rw [hx]

theorem integral_projection_deviation_sq (m : MeasurableSpace α) (hm : m ≤ m₀)
    (f : Lp ℝ 2 μ) :
    (∫ x, (f x - projection μ m hm f x) ^ 2 ∂μ) = ‖f - projection μ m hm f‖ ^ 2 := by
  rw [← @integral_sq_eq_L2_norm_sq α m₀ μ (f - projection μ m hm f)]
  apply integral_congr_ae
  filter_upwards [Lp.coeFn_sub f (projection μ m hm f)] with x hx
  change (f - projection μ m hm f) x = f x - projection μ m hm f x at hx
  rw [hx]

/-- The finite-measure premise is retained explicitly to match the public
finite-measure conditional-variance interface below. -/
theorem integrable_condExp_deviation_sq [IsFiniteMeasure μ] (m : MeasurableSpace α)
    (f : Lp ℝ 2 μ) :
    Integrable (fun x ↦ (f x - μ[(f : α → ℝ) | m] x) ^ 2) μ :=
  ((Lp.memLp f).sub ((Lp.memLp f).condExp one_le_two)).integrable_sq

section FiniteMeasure

variable [IsFiniteMeasure μ]

theorem projection_const (m : MeasurableSpace α) (hm : m ≤ m₀) (c : ℝ) :
    projection μ m hm (Lp.const 2 μ c) = Lp.const 2 μ c := by
  change (condExpL2 ℝ ℝ hm (Lp.const 2 μ c) : Lp ℝ 2 μ) = _
  simpa only [indicatorConstLp_univ] using
    (condExpL2_indicator_of_measurable (E := ℝ) (𝕜 := ℝ) hm (s := univ) MeasurableSet.univ
      (measure_ne_top μ univ) c)

theorem integral_projection (m : MeasurableSpace α) (hm : m ≤ m₀) (f : Lp ℝ 2 μ) :
    (∫ x, projection μ m hm f x ∂μ) = ∫ x, f x ∂μ := by
  change (∫ x, (condExpL2 ℝ ℝ hm f : Lp ℝ 2 μ) x ∂μ) = ∫ x, f x ∂μ
  simpa only [Measure.restrict_univ] using
    (integral_condExpL2_eq_of_fin_meas_real (hm := hm) f (s := univ)
      MeasurableSet.univ (measure_ne_top μ univ))

theorem projection_ae_eq_condExp (m : MeasurableSpace α) (hm : m ≤ m₀) (f : Lp ℝ 2 μ) :
    (projection μ m hm f : α → ℝ) =ᵐ[μ] μ[(f : α → ℝ) | m] := by
  change (condExpL2 ℝ ℝ hm f : α → ℝ) =ᵐ[μ] μ[(f : α → ℝ) | m]
  simpa only [Lp.toLp_coeFn] using
    (Lp.memLp f).condExpL2_ae_eq_condExp (E := ℝ) (𝕜 := ℝ) hm

/-- Positivity as an order-preserving conditional expectation, in addition
to the Hilbert-space positivity proved above. -/
theorem projection_ae_nonneg (m : MeasurableSpace α) (hm : m ≤ m₀) (f : Lp ℝ 2 μ)
    (hf : 0 ≤ᵐ[μ] (f : α → ℝ)) : 0 ≤ᵐ[μ] (projection μ m hm f : α → ℝ) := by
  filter_upwards [projection_ae_eq_condExp μ m hm f,
    condExp_nonneg (m := m) hf] with x hx hpos
  simpa only [hx] using hpos

/-- The genuine Mathlib conditional variance has this finite integral.
Its totalized nonintegrable branch is excluded by
`integrable_condExp_deviation_sq`. -/
theorem integral_condVar_eq_norm_sub_sq (m : MeasurableSpace α) (hm : m ≤ m₀)
    (f : Lp ℝ 2 μ) :
    (∫ x, ProbabilityTheory.condVar m (f : α → ℝ) μ x ∂μ) =
      ‖f - projection μ m hm f‖ ^ 2 := by
  calc
    _ = ∫ x, (f x - μ[(f : α → ℝ) | m] x) ^ 2 ∂μ := by
      simpa only [Measure.restrict_univ] using
        (ProbabilityTheory.setIntegral_condVar (hm := hm)
          (integrable_condExp_deviation_sq μ m f) (s := univ) MeasurableSet.univ)
    _ = ∫ x, (f x - projection μ m hm f x) ^ 2 ∂μ := by
      apply integral_congr_ae
      filter_upwards [projection_ae_eq_condExp μ m hm f] with x hx
      rw [hx]
    _ = _ := integral_projection_deviation_sq μ m hm f

theorem inner_const_one_eq_integral (f : Lp ℝ 2 μ) :
    ⟪Lp.const 2 μ (1 : ℝ), f⟫_ℝ = ∫ x, f x ∂μ := by
  simpa only [indicatorConstLp_univ, Measure.restrict_univ] using
    (L2.inner_indicatorConstLp_one (𝕜 := ℝ) (s := univ) MeasurableSet.univ
      (measure_ne_top μ univ) f)

theorem projection_deviation_sub_const (m : MeasurableSpace α) (hm : m ≤ m₀)
    (f : Lp ℝ 2 μ) (c : ℝ) :
    (f - Lp.const 2 μ c) - projection μ m hm (f - Lp.const 2 μ c) =
      f - projection μ m hm f := by
  rw [map_sub, projection_const]
  abel

end FiniteMeasure

section Average

variable {ι : Type*} [Fintype ι]
variable (m : ι → MeasurableSpace α) (hm : ∀ i, m i ≤ m₀)

/-- The actual average of the conditional-expectation maps. Its value for
an empty family is zero; mean preservation uses a nonempty family. -/
def average : Lp ℝ 2 μ →L[ℝ] Lp ℝ 2 μ :=
  (Fintype.card ι : ℝ)⁻¹ • ∑ i, projection μ (m i) (hm i)

theorem average_apply (f : Lp ℝ 2 μ) :
    average μ m hm f = (Fintype.card ι : ℝ)⁻¹ • ∑ i, projection μ (m i) (hm i) f := by
  simp only [average, smul_apply, sum_apply]

theorem average_eq_zero_of_isEmpty [IsEmpty ι] : average μ m hm = 0 := by
  simp [average]

theorem average_inner_symm (f g : Lp ℝ 2 μ) :
    ⟪average μ m hm f, g⟫_ℝ = ⟪f, average μ m hm g⟫_ℝ := by
  simp only [average_apply, real_inner_smul_left, inner_smul_right, sum_inner, inner_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  exact projection_inner_symm μ (m i) (hm i) f g

theorem average_isSelfAdjoint : IsSelfAdjoint (average μ m hm) :=
  ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr (average_inner_symm μ m hm)

theorem average_inner (f : Lp ℝ 2 μ) :
    ⟪f, average μ m hm f⟫_ℝ =
      (Fintype.card ι : ℝ)⁻¹ * ∑ i, ‖projection μ (m i) (hm i) f‖ ^ 2 := by
  simp only [average_apply, inner_smul_right, inner_sum, projection_inner_self]

theorem average_isPositive : (average μ m hm).IsPositive := by
  apply (ContinuousLinearMap.isPositive_iff' _).mpr
  refine ⟨average_isSelfAdjoint μ m hm, ?_⟩
  intro f
  rw [real_inner_comm f (average μ m hm f), average_inner]
  exact mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _))
    (Finset.sum_nonneg fun i _ ↦ sq_nonneg _)

variable [Nonempty ι]

theorem cardinal_ne_zero : (Fintype.card ι : ℝ) ≠ 0 :=
  (Nat.cast_pos.mpr Fintype.card_pos).ne'

theorem norm_average_le (f : Lp ℝ 2 μ) : ‖average μ m hm f‖ ≤ ‖f‖ := by
  rw [average_apply, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _))]
  calc
    _ ≤ (Fintype.card ι : ℝ)⁻¹ * ∑ i, ‖projection μ (m i) (hm i) f‖ :=
      mul_le_mul_of_nonneg_left (norm_sum_le _ _) (inv_nonneg.mpr (Nat.cast_nonneg _))
    _ ≤ (Fintype.card ι : ℝ)⁻¹ * ∑ _i : ι, ‖f‖ :=
      mul_le_mul_of_nonneg_left
        (Finset.sum_le_sum fun i _ ↦ norm_projection_le μ (m i) (hm i) f)
        (inv_nonneg.mpr (Nat.cast_nonneg _))
    _ = ‖f‖ := by
      rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← mul_assoc,
        inv_mul_cancel₀ (cardinal_ne_zero (ι := ι)), one_mul]

theorem average_opNorm_le_one : ‖average μ m hm‖ ≤ 1 := by
  apply (average μ m hm).opNorm_le_bound zero_le_one
  intro f
  simpa only [one_mul] using norm_average_le μ m hm f

/-- Exact quadratic form, with the source's literal cardinal normalization. -/
theorem average_defect_quadratic (f : Lp ℝ 2 μ) :
    ⟪f, (1 - average μ m hm) f⟫_ℝ =
      (Fintype.card ι : ℝ)⁻¹ * ∑ i, ‖f - projection μ (m i) (hm i) f‖ ^ 2 := by
  change ⟪f, f - average μ m hm f⟫_ℝ = _
  rw [inner_sub_right, real_inner_self_eq_norm_sq, average_inner]
  simp_rw [projection_norm_sub_sq]
  rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    mul_sub, ← mul_assoc, inv_mul_cancel₀ (cardinal_ne_zero (ι := ι)), one_mul]

/-- Together with positivity of the average, this is the operator interval
statement `0 ≤ K ≤ I`, expressed without selecting an operator order. -/
theorem one_sub_average_isPositive : (1 - average μ m hm).IsPositive := by
  apply (ContinuousLinearMap.isPositive_iff _).mpr
  constructor
  · intro f g
    change ⟪f - average μ m hm f, g⟫_ℝ = ⟪f, g - average μ m hm g⟫_ℝ
    rw [inner_sub_left, inner_sub_right, average_inner_symm]
  · intro f
    rw [real_inner_comm f ((1 - average μ m hm) f), average_defect_quadratic]
    exact mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _))
      (Finset.sum_nonneg fun i _ ↦ sq_nonneg _)

theorem average_defect_eq_average_integral_sq (f : Lp ℝ 2 μ) :
    ⟪f, (1 - average μ m hm) f⟫_ℝ = (Fintype.card ι : ℝ)⁻¹ *
      ∑ i, ∫ x, (f x - projection μ (m i) (hm i) f x) ^ 2 ∂μ := by
  simp only [integral_projection_deviation_sq, average_defect_quadratic]

variable [IsFiniteMeasure μ]

theorem integral_average (f : Lp ℝ 2 μ) :
    (∫ x, average μ m hm f x ∂μ) = ∫ x, f x ∂μ := by
  rw [← inner_const_one_eq_integral μ (average μ m hm f), average_apply,
    inner_smul_right, inner_sum]
  simp_rw [inner_const_one_eq_integral, integral_projection]
  rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← mul_assoc,
    inv_mul_cancel₀ (cardinal_ne_zero (ι := ι)), one_mul]

theorem integral_average_eq_zero {f : Lp ℝ 2 μ} (hf : (∫ x, f x ∂μ) = 0) :
    (∫ x, average μ m hm f x ∂μ) = 0 := by rw [integral_average, hf]

/-- The actual conditional variances, not an assumed variance formula. -/
theorem average_defect_eq_average_condVar (f : Lp ℝ 2 μ) :
    ⟪f, (1 - average μ m hm) f⟫_ℝ = (Fintype.card ι : ℝ)⁻¹ *
      ∑ i, ∫ x, ProbabilityTheory.condVar (m i) (f : α → ℝ) μ x ∂μ := by
  have hvar (i : ι) := integral_condVar_eq_norm_sub_sq μ (m i) (hm i) f
  simp only [hvar, average_defect_quadratic]

theorem average_defect_sub_const (f : Lp ℝ 2 μ) (c : ℝ) :
    ⟪f - Lp.const 2 μ c, (1 - average μ m hm) (f - Lp.const 2 μ c)⟫_ℝ =
      (Fintype.card ι : ℝ)⁻¹ * ∑ i, ‖f - projection μ (m i) (hm i) f‖ ^ 2 := by
  simp only [average_defect_quadratic, projection_deviation_sub_const]

/-- This is the identity used for the actual centered class in the source. -/
theorem centered_average_defect_eq_average_condVar (f : Lp ℝ 2 μ) :
    let g := f - Lp.const 2 μ (∫ x, f x ∂μ)
    ⟪g, (1 - average μ m hm) g⟫_ℝ = (Fintype.card ι : ℝ)⁻¹ *
      ∑ i, ∫ x, ProbabilityTheory.condVar (m i) (f : α → ℝ) μ x ∂μ := by
  dsimp only
  have hvar (i : ι) := integral_condVar_eq_norm_sub_sq μ (m i) (hm i) f
  simp only [average_defect_sub_const, hvar]

end Average

section ProductCoordinates

variable {ι : Type*} (E : ι → Type*) [∀ j, MeasurableSpace (E j)]

/-- The actual outside-coordinate map, for a dependent product. -/
def omitCoordinate (i : ι) (x : ∀ j, E j) : ∀ j : {j : ι // j ≠ i}, E j :=
  fun j ↦ x j

theorem measurable_omitCoordinate (i : ι) : Measurable (omitCoordinate E i) :=
  measurable_pi_iff.mpr fun j ↦ measurable_pi_apply j.val

/-- Precisely the sigma-algebra generated by all coordinates except i. -/
@[instance_reducible] def outsideSigma (i : ι) : MeasurableSpace (∀ j, E j) :=
  MeasurableSpace.comap (omitCoordinate E i) inferInstance

theorem outsideSigma_le (i : ι) :
    outsideSigma E i ≤ (inferInstance : MeasurableSpace (∀ j, E j)) :=
  (measurable_omitCoordinate E i).comap_le

/-- This construction uses the supplied joint measure, with no assertion
that any of its marginals has a particular Gibbs density. -/
def coordinateProjection (ν : Measure (∀ j, E j)) (i : ι) :
    Lp ℝ 2 ν →L[ℝ] Lp ℝ 2 ν :=
  projection ν (outsideSigma E i) (outsideSigma_le E i)

theorem coordinateProjection_ae_eq_condExp (ν : Measure (∀ j, E j)) [IsProbabilityMeasure ν]
    (i : ι) (f : Lp ℝ 2 ν) :
    (coordinateProjection E ν i f : (∀ j, E j) → ℝ) =ᵐ[ν]
      ν[(f : (∀ j, E j) → ℝ) | outsideSigma E i] :=
  projection_ae_eq_condExp ν (outsideSigma E i) (outsideSigma_le E i) f

variable [Fintype ι] [Nonempty ι]

def coordinateAverage (ν : Measure (∀ j, E j)) : Lp ℝ 2 ν →L[ℝ] Lp ℝ 2 ν :=
  average ν (outsideSigma E) (outsideSigma_le E)

omit [Nonempty ι] in
theorem coordinateAverage_isSelfAdjoint (ν : Measure (∀ j, E j)) :
    IsSelfAdjoint (coordinateAverage E ν) :=
  average_isSelfAdjoint ν (outsideSigma E) (outsideSigma_le E)

theorem coordinateAverage_positive_contraction (ν : Measure (∀ j, E j)) :
    (coordinateAverage E ν).IsPositive ∧ (1 - coordinateAverage E ν).IsPositive ∧
      ‖coordinateAverage E ν‖ ≤ 1 :=
  ⟨average_isPositive ν (outsideSigma E) (outsideSigma_le E),
    one_sub_average_isPositive ν (outsideSigma E) (outsideSigma_le E),
    average_opNorm_le_one ν (outsideSigma E) (outsideSigma_le E)⟩

theorem integral_coordinateAverage (ν : Measure (∀ j, E j)) [IsProbabilityMeasure ν]
    (f : Lp ℝ 2 ν) : (∫ x, coordinateAverage E ν f x ∂ν) = ∫ x, f x ∂ν :=
  integral_average ν (outsideSigma E) (outsideSigma_le E) f

theorem coordinateAverage_defect_eq_average_condVar (ν : Measure (∀ j, E j))
    [IsProbabilityMeasure ν] (f : Lp ℝ 2 ν) :
    ⟪f, (1 - coordinateAverage E ν) f⟫_ℝ = (Fintype.card ι : ℝ)⁻¹ *
      ∑ i, ∫ x, ProbabilityTheory.condVar (outsideSigma E i) (f : (∀ j, E j) → ℝ) ν x ∂ν :=
  average_defect_eq_average_condVar ν (outsideSigma E) (outsideSigma_le E) f

theorem centered_coordinateAverage_defect_eq_average_condVar (ν : Measure (∀ j, E j))
    [IsProbabilityMeasure ν] (f : Lp ℝ 2 ν) :
    let g := f - Lp.const 2 ν (∫ x, f x ∂ν)
    ⟪g, (1 - coordinateAverage E ν) g⟫_ℝ = (Fintype.card ι : ℝ)⁻¹ *
      ∑ i, ∫ x, ProbabilityTheory.condVar (outsideSigma E i) (f : (∀ j, E j) → ℝ) ν x ∂ν :=
  centered_average_defect_eq_average_condVar ν (outsideSigma E) (outsideSigma_le E) f

end ProductCoordinates

