                ∀ (f : ↥(DGPS.centeredL2 (DGPS.densityMeasure μ))),
                  c * ‖f‖ ^ 2 ≤ inner ℝ f ((DGPS.densityHessian A (DGPS.densityMeasure μ)) f))
