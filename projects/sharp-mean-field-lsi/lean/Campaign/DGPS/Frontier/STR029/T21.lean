/-! ### The symmetry data -/

/-- The circle isometry `t ↦ σ t + c`, `σ = ±1`, maps `cos 3t` to `ε cos 3t` and `sin 3t` to
`σ ε sin 3t`. The induced parameter action is `actPar_STR02921 σ c ε`. -/
def SymOK_STR02921 (σ c ε : ℝ) : Prop :=
  (σ = 1 ∨ σ = -1) ∧ (∀ t : ℝ, Real.cos (3 * (σ * t + c)) = ε * Real.cos (3 * t)) ∧
    (∀ t : ℝ, Real.sin (3 * (σ * t + c)) = σ * ε * Real.sin (3 * t))

/-- The translation `T_{2π k/3}`, that is `t ↦ t - 2π k/3`, preserves `cos 3t` and `sin 3t`. -/
theorem symOK_rot_STR02921 (k : ℤ) : SymOK_STR02921 1 (-(2 * Real.pi * k / 3)) 1 := by
  refine ⟨Or.inl rfl, fun t => ?_, fun t => ?_⟩
  · have h : 3 * (1 * t + -(2 * Real.pi * k / 3)) = 3 * t - k * (2 * Real.pi) := by ring
    rw [h, Real.cos_sub_int_mul_two_pi]
    ring
  · have h : 3 * (1 * t + -(2 * Real.pi * k / 3)) = 3 * t - k * (2 * Real.pi) := by ring
    rw [h, Real.sin_sub_int_mul_two_pi]
    ring

/-- The reflection `t ↦ -t` preserves `cos 3t` and reverses `sin 3t`. -/
theorem symOK_refl_STR02921 : SymOK_STR02921 (-1) 0 1 := by
  refine ⟨Or.inr rfl, fun t => ?_, fun t => ?_⟩
  · have h : 3 * (-1 * t + 0) = -(3 * t) := by ring
    rw [h, Real.cos_neg]
    ring
  · have h : 3 * (-1 * t + 0) = -(3 * t) := by ring
    rw [h, Real.sin_neg]
    ring

/-- The half period shift `T_π`, `t ↦ t - π`, reverses `cos 3t` and `sin 3t`. -/
theorem symOK_half_STR02921 : SymOK_STR02921 1 (-Real.pi) (-1) := by
  refine ⟨Or.inl rfl, fun t => ?_, fun t => ?_⟩
  · have h : 3 * (1 * t + -Real.pi) = (3 * t - Real.pi) - 2 * Real.pi := by ring
    rw [h, Real.cos_sub_two_pi, Real.cos_sub_pi]
    ring
  · have h : 3 * (1 * t + -Real.pi) = (3 * t - Real.pi) - 2 * Real.pi := by ring
    rw [h, Real.sin_sub_two_pi, Real.sin_sub_pi]
    ring

/-- The action on the parameters `(a, b, h, γ)` induced by the pullback along `t ↦ σ t + c`
with `cos 3 (σ t + c) = ε cos 3t`. -/
noncomputable def actPar_STR02921 (σ c ε : ℝ) (p : Par_STR02916) : Par_STR02916 :=
  (p.1 * Real.cos c + p.2.1 * Real.sin c, σ * (-(p.1 * Real.sin c) + p.2.1 * Real.cos c),
    ε * p.2.2.1, p.2.2.2)

theorem actPar_rot_STR02921 (θ : ℝ) (p : Par_STR02916) :
    actPar_STR02921 1 (-θ) 1 p = rotPar_STR02916 θ p := by
  unfold actPar_STR02921 rotPar_STR02916
  refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ rfl))
  · simp only [Real.cos_neg, Real.sin_neg]
    ring
  · simp only [Real.cos_neg, Real.sin_neg]
    ring
  · simp

theorem actPar_refl_STR02921 (p : Par_STR02916) : actPar_STR02921 (-1) 0 1 p = reflPar_STR02916 p := by
  unfold actPar_STR02921 reflPar_STR02916
  refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ rfl))
  · simp
  · simp
  · simp

theorem actPar_sign_STR02921 (p : Par_STR02916) :
    actPar_STR02921 1 (-Real.pi) (-1) p = signPar_STR02916 p := by
  unfold actPar_STR02921 signPar_STR02916
  refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ rfl))
  · simp
  · simp
  · simp

/-! ### Pullback of the density, of the gradient and of the projection -/

theorem periodic_deriv_STR02921 {f : ℝ → ℝ} (hf : Function.Periodic f (2 * Real.pi)) :
    Function.Periodic (deriv f) (2 * Real.pi) := by
  intro x
  have h1 : (fun y => f (y + 2 * Real.pi)) = f := funext hf
  have h2 := deriv_comp_add_const (f := f) (2 * Real.pi) x
  rw [h1] at h2
  exact h2.symm

theorem periodic_exp_STR02921 (h : ℝ) {u : ℝ → ℝ} (hu : Function.Periodic u (2 * Real.pi)) :
    Function.Periodic (fun s : ℝ => Real.exp (h * Real.cos (3 * s) + u s)) (2 * Real.pi) := by
  intro t
  simp only [cos3_periodic_STR02904 t, hu t]

theorem periodic_rho_STR02921 (h : ℝ) {u : ℝ → ℝ} (hu : Function.Periodic u (2 * Real.pi)) :
    Function.Periodic (rhoT_STR02901 h u) (2 * Real.pi) := by
  intro t
  have h1 := periodic_exp_STR02921 h hu t
  unfold rhoT_STR02901
  simp only at h1
  rw [h1]

/-- The mean of `exp (ε h cos 3s + u (σ s + c))` is the mean of `exp (h cos 3s + u s)`. -/
theorem meanExp_pb_STR02921 {σ c ε : ℝ} (hS : SymOK_STR02921 σ c ε) (h : ℝ) {u : ℝ → ℝ}
    (hu : Function.Periodic u (2 * Real.pi)) :
    meanT_STR02901 (fun s => Real.exp (ε * h * Real.cos (3 * s) + pb_STR02916 σ c u s)) =
      meanT_STR02901 (fun s => Real.exp (h * Real.cos (3 * s) + u s)) := by
  have hf : (fun s => Real.exp (ε * h * Real.cos (3 * s) + pb_STR02916 σ c u s)) =
      pb_STR02916 σ c (fun s => Real.exp (h * Real.cos (3 * s) + u s)) := by
    funext s
    simp only [pb_STR02916, hS.2.1 s]
    ring_nf
  rw [hf]
  exact meanT_pb_STR02916 hS.1 c (periodic_exp_STR02921 h hu)

/-- The mean of `exp (ε h cos 3s)` is the mean of `exp (h cos 3s)`. -/
theorem meanExp0_pb_STR02921 {σ c ε : ℝ} (hS : SymOK_STR02921 σ c ε) (h : ℝ) :
    meanT_STR02901 (fun s => Real.exp (ε * h * Real.cos (3 * s))) =
      meanT_STR02901 (fun s => Real.exp (h * Real.cos (3 * s))) := by
  have hf : (fun s => Real.exp (ε * h * Real.cos (3 * s))) =
      pb_STR02916 σ c (fun s => Real.exp (h * Real.cos (3 * s))) := by
    funext s
    simp only [pb_STR02916, hS.2.1 s]
    ring_nf
  rw [hf]
  exact meanT_pb_STR02916 hS.1 c (expCos_periodic_STR02904 h)

/-- The density `ρ (ε h, u ∘ φ)` is `ρ (h, u) ∘ φ` for the isometry `φ`. -/
theorem rho_pb_STR02921 {σ c ε : ℝ} (hS : SymOK_STR02921 σ c ε) (h : ℝ) {u : ℝ → ℝ}
    (hu : Function.Periodic u (2 * Real.pi)) :
    rhoT_STR02901 (ε * h) (pb_STR02916 σ c u) = pb_STR02916 σ c (rhoT_STR02901 h u) := by
  funext t
  have hm := meanExp_pb_STR02921 hS h hu
  unfold rhoT_STR02901
  rw [hm]
  simp only [pb_STR02916, hS.2.1 t]
  ring_nf

/-- The expression `G` of STR029.12 with free integrals `I`, `E` is natural under the isometry. -/
theorem gradG12_pb_STR02921 {σ c ε : ℝ} (hS : SymOK_STR02921 σ c ε) (h γ I E : ℝ) {u : ℝ → ℝ}
    (hper : Function.Periodic u (2 * Real.pi)) (hd : Differentiable ℝ u)
    (hd' : Differentiable ℝ (deriv u)) :
    gradG_STR02912 (ε * h) γ I E (pb_STR02916 σ c u) =
      pb_STR02916 σ c (gradG_STR02912 h γ I E u) := by
  funext t
  have e1 := deriv_pb_STR02916 (σ := σ) (c := c) hd
  have e2 := deriv2_pb_STR02916 (c := c) hS.1 hd hd'
  have hρ := congrFun (rho_pb_STR02921 hS h hper) t
  have hs := hS.2.2 t
  unfold gradG_STR02912
  rw [hρ, e2, e1]
  simp only [pb_STR02916] at hs ⊢
  rw [hs]
  rcases hS.1 with rfl | rfl <;> ring

/-- The pullback of the closed gradient of STR029.50. -/
theorem gradG_pb_STR02921 {σ c ε : ℝ} (hS : SymOK_STR02921 σ c ε) (h γ : ℝ) {u : ℝ → ℝ}
    (hper : Function.Periodic u (2 * Real.pi)) (hd : Differentiable ℝ u)
    (hd' : Differentiable ℝ (deriv u)) :
    gradG_STR02950 (ε * h) γ (pb_STR02916 σ c u) = pb_STR02916 σ c (gradG_STR02950 h γ u) := by
  have hI : meanT_STR02901 (fun r => deriv (pb_STR02916 σ c u) r ^ 2 *
      rhoT_STR02901 (ε * h) (pb_STR02916 σ c u) r) =
      meanT_STR02901 (fun r => deriv u r ^ 2 * rhoT_STR02901 h u r) := by
    have hf : (fun r => deriv (pb_STR02916 σ c u) r ^ 2 *
        rhoT_STR02901 (ε * h) (pb_STR02916 σ c u) r) =
        pb_STR02916 σ c (fun r => deriv u r ^ 2 * rhoT_STR02901 h u r) := by
      funext r
      rw [deriv_pb_STR02916 hd, rho_pb_STR02921 hS h hper]
      simp only [pb_STR02916]
      rcases hS.1 with rfl | rfl <;> ring
    rw [hf]
    refine meanT_pb_STR02916 hS.1 c (fun r => ?_)
    simp only [periodic_deriv_STR02921 hper r, periodic_rho_STR02921 h hper r]
  have hE : meanT_STR02901 (fun r => pb_STR02916 σ c u r *
      rhoT_STR02901 (ε * h) (pb_STR02916 σ c u) r) =
      meanT_STR02901 (fun r => u r * rhoT_STR02901 h u r) := by
    have hf : (fun r => pb_STR02916 σ c u r * rhoT_STR02901 (ε * h) (pb_STR02916 σ c u) r) =
        pb_STR02916 σ c (fun r => u r * rhoT_STR02901 h u r) := by
      funext r
      rw [rho_pb_STR02921 hS h hper]
      rfl
    rw [hf]
    exact meanT_pb_STR02916 hS.1 c (hper.mul (periodic_rho_STR02921 h hper))
  have h12 := gradG12_pb_STR02921 hS h γ (meanT_STR02901 (fun r => deriv u r ^ 2 *
      rhoT_STR02901 h u r)) (meanT_STR02901 (fun r => u r * rhoT_STR02901 h u r)) hper hd hd'
  have hL : gradG_STR02950 (ε * h) γ (pb_STR02916 σ c u) =
      gradG_STR02912 (ε * h) γ (meanT_STR02901 (fun r => deriv (pb_STR02916 σ c u) r ^ 2 *
        rhoT_STR02901 (ε * h) (pb_STR02916 σ c u) r))
        (meanT_STR02901 (fun r => pb_STR02916 σ c u r *
          rhoT_STR02901 (ε * h) (pb_STR02916 σ c u) r)) (pb_STR02916 σ c u) :=
    (gradG_eq_STR02912 (ε * h) γ (pb_STR02916 σ c u)).symm
  rw [hL, hI, hE]
  exact h12

theorem cos_aff_STR02921 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c t : ℝ) :
    Real.cos (σ * t + c) = Real.cos t * Real.cos c - σ * Real.sin t * Real.sin c := by
  rcases hσ with rfl | rfl
  · rw [one_mul, Real.cos_add]
    ring
  · rw [neg_one_mul, Real.cos_add, Real.cos_neg, Real.sin_neg]
    ring

theorem sin_aff_STR02921 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c t : ℝ) :
    Real.sin (σ * t + c) = σ * Real.sin t * Real.cos c + Real.cos t * Real.sin c := by
  rcases hσ with rfl | rfl
  · rw [one_mul, Real.sin_add]
    ring
  · rw [neg_one_mul, Real.sin_add, Real.cos_neg, Real.sin_neg]
    ring

/-- The complement of the first harmonics, `P f = f - ∫ f - 2 (∫ f cos) cos - 2 (∫ f sin) sin`,
is natural under the isometry. -/
theorem projP_pb_STR02921 {σ c : ℝ} (hσ : σ = 1 ∨ σ = -1) {f : ℝ → ℝ} (hc : Continuous f)
    (hper : Function.Periodic f (2 * Real.pi)) :
    projP_STR02953 (pb_STR02916 σ c f) = pb_STR02916 σ c (projP_STR02953 f) := by
  funext t
  have h1 := Real.sin_sq_add_cos_sq c
  have h2 := sq_eq_one_STR02916 hσ
  have hcos : ∀ t, Real.cos t = Real.cos c * Real.cos (σ * t + c) +
      Real.sin c * Real.sin (σ * t + c) := by
    intro t
    rw [cos_aff_STR02921 hσ, sin_aff_STR02921 hσ]
    linear_combination (-(Real.cos t)) * h1
  have hsin : ∀ t, Real.sin t = (-σ * Real.sin c) * Real.cos (σ * t + c) +
      (σ * Real.cos c) * Real.sin (σ * t + c) := by
    intro t
    rw [cos_aff_STR02921 hσ, sin_aff_STR02921 hσ]
    linear_combination (-(Real.sin t)) * h2 + (-(Real.sin t * σ * σ)) * h1
  have hm := meanT_pb_STR02916 hσ c hper
  have e1 := meanT_pb_trig_STR02916 hσ c hc hper (Real.cos c) (Real.sin c) hcos
  have e2 := meanT_pb_trig_STR02916 hσ c hc hper (-σ * Real.sin c) (σ * Real.cos c) hsin
  show projP_STR02953 (pb_STR02916 σ c f) t = projP_STR02953 f (σ * t + c)
  simp only [projP_STR02953, pair_STR02953]
  rw [hm, e1, e2, cos_aff_STR02921 hσ, sin_aff_STR02921 hσ]
  simp only [pb_STR02916]
  ring

/-! ### The range map along an isometry -/

/-- The chart `u = a cos t + b sin t + w` is natural: rotating `(a, b)` and pulling `w` back along
the isometry pulls `u` back. -/
theorem uT_pb_STR02921 {σ c : ℝ} (hσ : σ = 1 ∨ σ = -1) (a b : ℝ) (w : ℝ → ℝ) :
    uT_STR02901 (a * Real.cos c + b * Real.sin c) (σ * (-(a * Real.sin c) + b * Real.cos c))
        (pb_STR02916 σ c w) = pb_STR02916 σ c (uT_STR02901 a b w) := by
  funext t
  simp only [uT_STR02901, pb_STR02916]
  rw [cos_aff_STR02921 hσ, sin_aff_STR02921 hσ]
  ring

/-- The chart function `a cos t + b sin t + w`, `w ∈ E`, belongs to `C^{2,1/2}`. -/
theorem uT_isC2_STR02921 (a b : ℝ) (w : E_STR02969) :
    IsC2Alpha_STR02901 (1 / 2) (uT_STR02901 a b ((w : E_STR02969) : PeriodicC2_STR02969).val) := by
  rw [← paramMap_val_STR02915]
  exact PeriodicC2_STR02969.isC2 _

/-- The gradient `G` of a chart function is periodic and continuous (it lies in the Hölder
carrier of STR029.55). -/
theorem gradG_uT_STR02921 (a b h γ : ℝ) (w : E_STR02969) :
    Function.Periodic (gradG_STR02950 h γ
        (uT_STR02901 a b ((w : E_STR02969) : PeriodicC2_STR02969).val)) (2 * Real.pi) ∧
      Continuous (gradG_STR02950 h γ
        (uT_STR02901 a b ((w : E_STR02969) : PeriodicC2_STR02969).val)) := by
  have h1 := (Gfun_STR02955 h γ (a • cosC2_STR02915 + b • sinC2_STR02915 +
    ((w : E_STR02969) : PeriodicC2_STR02969))).isPerHolder
  rw [Gfun_val_STR02955, paramMap_val_STR02915] at h1
  exact ⟨h1.1, h1.2.1⟩

/-- The values of the variational range map: `R (a, b, h, γ, w) = P G (h, γ, a cos + b sin + w)`. -/
