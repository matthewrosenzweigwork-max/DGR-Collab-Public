/-! ### A smooth implicit-function theorem with a common open domain -/

/-- Pointwise upgrade of the Mathlib implicit function theorem. For a globally `C^∞` map `F` with
`F (p₀, w₀) = 0` and invertible partial derivative in the second variable, there are open
neighbourhoods `U` of `p₀` and `N` of `w₀` and a map `ψ` that is `C^∞` on all of `U`, maps `U` into
`N`, and parametrizes the zero set of `F` in `U × N`. -/
theorem implicit_graph_STR02916
    {P W V : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P] [CompleteSpace P]
    [NormedAddCommGroup W] [NormedSpace ℝ W] [CompleteSpace W]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [CompleteSpace V]
    {F : P × W → V} (hF : ContDiff ℝ ∞ F) {p₀ : P} {w₀ : W} (h0 : F (p₀, w₀) = 0)
    (hinv : (fderiv ℝ F (p₀, w₀) ∘L ContinuousLinearMap.inr ℝ P W).IsInvertible) :
    ∃ (U : Set P) (N : Set W) (ψ : P → W), IsOpen U ∧ p₀ ∈ U ∧ IsOpen N ∧ w₀ ∈ N ∧
      ContDiffOn ℝ ∞ ψ U ∧ ψ p₀ = w₀ ∧ (∀ p ∈ U, ψ p ∈ N) ∧
      ∀ p ∈ U, ∀ w ∈ N, F (p, w) = 0 ↔ ψ p = w := by
  have pn : ((∞ : ℕ∞ω)) ≠ 0 := by simp
  have hcd : ContDiffAt ℝ ∞ F (p₀, w₀) := hF.contDiffAt
  set ψ₀ : P → W := hcd.implicitFunction pn hinv with hψ₀
  have hψ₀cd : ContDiffAt ℝ ∞ ψ₀ p₀ := hcd.contDiffAt_implicitFunction pn hinv
  have hψ₀self : ψ₀ p₀ = w₀ := hcd.implicitFunction_apply_self pn hinv
  -- the set of points where the partial derivative is invertible is open
  have hcontD : Continuous (fun u : P × W => fderiv ℝ F u ∘L ContinuousLinearMap.inr ℝ P W) :=
    (hF.continuous_fderiv (by simp)).clm_comp continuous_const
  have hSopen : IsOpen {u : P × W | (fderiv ℝ F u ∘L ContinuousLinearMap.inr ℝ P W).IsInvertible} :=
    ContinuousLinearMap.isOpen_setOfPred_isInvertible.preimage hcontD
  have hS : ∀ᶠ u in 𝓝 (p₀, w₀), (fderiv ℝ F u ∘L ContinuousLinearMap.inr ℝ P W).IsInvertible :=
    hSopen.mem_nhds hinv
  have hG : ∀ᶠ v in 𝓝 (p₀, w₀), F v = F (p₀, w₀) ↔ ψ₀ v.1 = v.2 :=
    hcd.eventually_apply_eq_iff_implicitFunction pn hinv
  have hSG : ∀ᶠ v in 𝓝 (p₀, w₀),
      (fderiv ℝ F v ∘L ContinuousLinearMap.inr ℝ P W).IsInvertible ∧
        (F v = F (p₀, w₀) ↔ ψ₀ v.1 = v.2) := hS.and hG
  obtain ⟨A, B, hA, hp₀A, hB, hw₀B, hsub⟩ := mem_nhds_prod_iff'.mp hSG
  -- shrink the base neighbourhood so that the graph stays in `B`
  have hpre : A ∩ ψ₀ ⁻¹' B ∈ 𝓝 p₀ :=
    Filter.inter_mem (hA.mem_nhds hp₀A) (hψ₀cd.continuousAt.preimage_mem_nhds (by
      rw [hψ₀self]; exact hB.mem_nhds hw₀B))
  set U : Set P := interior (A ∩ ψ₀ ⁻¹' B) with hU
  have hUopen : IsOpen U := isOpen_interior
  have hp₀U : p₀ ∈ U := mem_interior_iff_mem_nhds.mpr hpre
  have hUA : ∀ p ∈ U, p ∈ A := fun p hp => (interior_subset hp).1
  have hUB : ∀ p ∈ U, ψ₀ p ∈ B := fun p hp => (interior_subset hp).2
  -- the key equivalence on `A ×ˢ B`
  have hkey : ∀ p ∈ A, ∀ w ∈ B, F (p, w) = 0 ↔ ψ₀ p = w := by
    intro p hp w hw
    have := (hsub (Set.mk_mem_prod hp hw)).2
    rw [h0] at this
    exact this
  have hinvAB : ∀ p ∈ A, ∀ w ∈ B,
      (fderiv ℝ F (p, w) ∘L ContinuousLinearMap.inr ℝ P W).IsInvertible :=
    fun p hp w hw => (hsub (Set.mk_mem_prod hp hw)).1
  -- smoothness at each point of `U`
  have hsmooth : ∀ p ∈ U, ContDiffAt ℝ ∞ ψ₀ p := by
    intro p hp
    have hFp : F (p, ψ₀ p) = 0 := (hkey p (hUA p hp) (ψ₀ p) (hUB p hp)).2 rfl
    have hinvp := hinvAB p (hUA p hp) (ψ₀ p) (hUB p hp)
    have cdu : ContDiffAt ℝ ∞ F (p, ψ₀ p) := hF.contDiffAt
    set ψu : P → W := cdu.implicitFunction pn hinvp with hψu
    have hψucd : ContDiffAt ℝ ∞ ψu p := cdu.contDiffAt_implicitFunction pn hinvp
    have hψuself : ψu p = ψ₀ p := cdu.implicitFunction_apply_self pn hinvp
    have h3 : ∀ᶠ p' in 𝓝 p, F (p', ψu p') = F (p, ψ₀ p) :=
      cdu.eventually_apply_implicitFunction pn hinvp
    have h4 : A ∈ 𝓝 p := hA.mem_nhds (hUA p hp)
    have h5 : ∀ᶠ p' in 𝓝 p, ψu p' ∈ B :=
      hψucd.continuousAt.preimage_mem_nhds (by rw [hψuself]; exact hB.mem_nhds (hUB p hp))
    have heq : ψ₀ =ᶠ[𝓝 p] ψu := by
      filter_upwards [h3, h4, h5] with p' h3' h4' h5'
      rw [hFp] at h3'
      exact (hkey p' h4' (ψu p') h5').1 h3'
    exact hψucd.congr_of_eventuallyEq heq
  refine ⟨U, B, ψ₀, hUopen, hp₀U, hB, hw₀B, fun p hp => (hsmooth p hp).contDiffWithinAt,
    hψ₀self, hUB, ?_⟩
  intro p hp w hw
  exact hkey p (hUA p hp) w hw

/-! ### The parameter-dependent range map -/

/-- The parameter space `ℝ⁴` with coordinates `(a, b, h, γ)`. -/
abbrev Par_STR02916 : Type := ℝ × ℝ × ℝ × ℝ

/-- The variational range map of STR029.15 with the parameters grouped as one factor:
`Rpar (a, b, h, γ) w = R(a, b, h, γ, w)`. -/
noncomputable def Rpar_STR02916 (p : Par_STR02916) (w : E_STR02969) : Y_STR02969 :=
  Rvar_STR02915 (p.1, p.2.1, p.2.2.1, p.2.2.2, w)

/-- `Rpar` as a map on the product `ℝ⁴ × E`. -/
noncomputable def Fp_STR02916 (q : Par_STR02916 × E_STR02969) : Y_STR02969 :=
  Rpar_STR02916 q.1 q.2

theorem Fp_smooth_STR02916 : ContDiff ℝ ∞ Fp_STR02916 := by
  have h : ContDiff ℝ ∞ (fun q : Par_STR02916 × E_STR02969 =>
      ((q.1.1, q.1.2.1, q.1.2.2.1, q.1.2.2.2, q.2) : ℝ × ℝ × ℝ × ℝ × E_STR02969)) := by
    fun_prop
  exact Rvar_smooth_STR02915.comp h

theorem Fp_zero_STR02916 : Fp_STR02916 ((0 : Par_STR02916), (0 : E_STR02969)) = 0 :=
  Rvar_zero_STR02915

/-- The partial derivative of `Fp` in the `E` direction at zero, pointwise. -/
theorem fderiv_Fp_apply_STR02916 (w : E_STR02969) (t : ℝ) :
    (((fderiv ℝ Fp_STR02916 ((0 : Par_STR02916), (0 : E_STR02969)) ∘L
        ContinuousLinearMap.inr ℝ Par_STR02916 E_STR02969) w : Y_STR02969) :
        PeriodicHolder_STR02968).val t =
      -2 * (deriv (deriv (w : PeriodicC2_STR02969).val) t + (w : PeriodicC2_STR02969).val t) := by
  obtain ⟨_, _, _, _, _, hD⟩ := str029_15_smooth_variational_range_map
  have hcomp : (fun v : E_STR02969 => Rvar_STR02915 (0, 0, 0, 0, v)) =
      Fp_STR02916 ∘ (ContinuousLinearMap.inr ℝ Par_STR02916 E_STR02969) := by
    funext v
    rfl
  have hdiff : DifferentiableAt ℝ Fp_STR02916
      (ContinuousLinearMap.inr ℝ Par_STR02916 E_STR02969 (0 : E_STR02969)) :=
    (Fp_smooth_STR02916.differentiable (by simp)) _
  have h1 : fderiv ℝ (fun v : E_STR02969 => Rvar_STR02915 (0, 0, 0, 0, v)) 0 =
      fderiv ℝ Fp_STR02916 ((0 : Par_STR02916), (0 : E_STR02969)) ∘L
        ContinuousLinearMap.inr ℝ Par_STR02916 E_STR02969 := by
    rw [hcomp, fderiv_comp (0 : E_STR02969) hdiff
      (ContinuousLinearMap.inr ℝ Par_STR02916 E_STR02969).differentiableAt,
      ContinuousLinearMap.fderiv]
    simp
  rw [← h1]
  exact hD w t

/-- The `E`-partial derivative of `Fp` at zero is invertible: it equals `-2 • (∂² + 1)`. -/
theorem Fp_inv_STR02916 :
    (fderiv ℝ Fp_STR02916 ((0 : Par_STR02916), (0 : E_STR02969)) ∘L
      ContinuousLinearMap.inr ℝ Par_STR02916 E_STR02969).IsInvertible := by
  obtain ⟨e, he, _⟩ := str029_14_bounded_isomorphism_complement
  have hD : (fderiv ℝ Fp_STR02916 ((0 : Par_STR02916), (0 : E_STR02969)) ∘L
      ContinuousLinearMap.inr ℝ Par_STR02916 E_STR02969) =
        (-2 : ℝ) • (e : E_STR02969 →L[ℝ] Y_STR02969) := by
    refine ContinuousLinearMap.ext fun w => ?_
    refine Subtype.ext (phext_STR02914 ?_)
    funext t
    have h1 := fderiv_Fp_apply_STR02916 w t
    have h2 := congrFun (he w) t
    simp only [smul_apply, ContinuousLinearEquiv.coe_coe,
      Submodule.coe_smul, PeriodicHolder_STR02968.val_smul, Pi.smul_apply, smul_eq_mul]
    rw [h1]
    simp only [Pi.add_apply] at h2
    rw [h2]
  rw [hD]
  refine ContinuousLinearMap.IsInvertible.of_inverse
    (g := (-1 / 2 : ℝ) • (e.symm : Y_STR02969 →L[ℝ] E_STR02969)) ?_ ?_
  · refine ContinuousLinearMap.ext fun y => ?_
    simp only [ContinuousLinearMap.coe_comp, Function.comp_apply, smul_apply,
      ContinuousLinearEquiv.coe_coe, map_smul, ContinuousLinearEquiv.apply_symm_apply,
      ContinuousLinearMap.coe_id', id_eq]
    module
  · refine ContinuousLinearMap.ext fun w => ?_
    simp only [ContinuousLinearMap.coe_comp, Function.comp_apply, smul_apply,
      ContinuousLinearEquiv.coe_coe, map_smul, ContinuousLinearEquiv.symm_apply_apply,
      ContinuousLinearMap.coe_id', id_eq]
    module

/-- The one-parameter family of equilibria: with `a = b = 0` and `w = 0` the range map vanishes for
every `h` and `γ`. -/
theorem Rpar_equilibrium_STR02916 (h γ : ℝ) : Rpar_STR02916 (0, 0, h, γ) 0 = 0 := by
  have hG : Gmap_STR02955 (paramMap_STR02915 (0, 0, h, γ, 0)) = 0 := by
    simp [paramMap_STR02915, Gmap_STR02955, Gfun_STR02955]
  simp [Rpar_STR02916, Rvar_STR02915, hG]

/-! ### Pullbacks along the circle isometries `t ↦ σ t + c`, `σ = ±1` -/

/-- Pullback of a function along the circle isometry `t ↦ σ t + c`. -/
def pb_STR02916 (σ c : ℝ) (f : ℝ → ℝ) : ℝ → ℝ := fun t => f (σ * t + c)

theorem sq_eq_one_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) : σ * σ = 1 := by
  rcases hσ with rfl | rfl <;> norm_num

theorem abs_eq_one_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) : |σ| = 1 := by
  rcases hσ with rfl | rfl <;> norm_num

theorem aff_surj_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c : ℝ) :
    Function.Surjective (fun t : ℝ => σ * t + c) := by
  intro y
  refine ⟨σ * (y - c), ?_⟩
  have h := sq_eq_one_STR02916 hσ
  calc σ * (σ * (y - c)) + c = (σ * σ) * (y - c) + c := by ring
    _ = y := by rw [h]; ring

theorem deriv_pb_STR02916 {σ c : ℝ} {f : ℝ → ℝ} (hf : Differentiable ℝ f) :
    deriv (pb_STR02916 σ c f) = fun t => σ * pb_STR02916 σ c (deriv f) t := by
  funext t
  have h1 : HasDerivAt (fun t : ℝ => σ * t + c) σ t := by
    simpa using ((hasDerivAt_id t).const_mul σ).add_const c
  have h2 := (hf (σ * t + c)).hasDerivAt.comp t h1
  show deriv (fun t => f (σ * t + c)) t = σ * deriv f (σ * t + c)
  rw [mul_comm]
  exact h2.deriv

theorem deriv2_pb_STR02916 {σ c : ℝ} (hσ : σ = 1 ∨ σ = -1) {f : ℝ → ℝ}
    (hf : Differentiable ℝ f) (hf' : Differentiable ℝ (deriv f)) :
    deriv (deriv (pb_STR02916 σ c f)) = pb_STR02916 σ c (deriv (deriv f)) := by
  rw [deriv_pb_STR02916 hf]
  funext t
  rw [deriv_const_mul_field, deriv_pb_STR02916 hf']
  show σ * (σ * deriv (deriv f) (σ * t + c)) = deriv (deriv f) (σ * t + c)
  rw [← mul_assoc, sq_eq_one_STR02916 hσ, one_mul]

theorem supNorm_pb_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c : ℝ) (f : ℝ → ℝ) :
    supNorm (pb_STR02916 σ c f) = supNorm f := by
  unfold supNorm pb_STR02916
  exact (aff_surj_STR02916 hσ c).iSup_comp (fun y => |f y|)

theorem supNorm_sign_mul_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (g : ℝ → ℝ) :
    supNorm (fun t => σ * g t) = supNorm g := by
  unfold supNorm
  simp only [abs_mul, abs_eq_one_STR02916 hσ, one_mul]

theorem circDist_aff_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c s t : ℝ) :
    circDist_STR02901 (σ * s + c) (σ * t + c) = circDist_STR02901 s t := by
  unfold circDist_STR02901
  rw [dist_eq_norm, dist_eq_norm, ← AddCircle.coe_sub, ← AddCircle.coe_sub]
  rcases hσ with rfl | rfl
  · have h : (1 * s + c) - (1 * t + c) = s - t := by ring
    rw [h]
  · have h : (-1 * s + c) - (-1 * t + c) = -(s - t) := by ring
    rw [h, AddCircle.coe_neg, norm_neg]

theorem circHolder_pb_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c α : ℝ) (g : ℝ → ℝ) :
    circHolder_STR02901 α (pb_STR02916 σ c g) = circHolder_STR02901 α g := by
  unfold circHolder_STR02901
  have hsurj : Function.Surjective (fun p : ℝ × ℝ => (σ * p.1 + c, σ * p.2 + c)) := by
    intro q
    obtain ⟨x, hx⟩ := aff_surj_STR02916 hσ c q.1
    obtain ⟨y, hy⟩ := aff_surj_STR02916 hσ c q.2
    exact ⟨(x, y), Prod.ext hx hy⟩
  refine Eq.trans ?_ (hsurj.iSup_comp
    (fun q : ℝ × ℝ => |g q.1 - g q.2| / circDist_STR02901 q.1 q.2 ^ α))
  refine iSup_congr fun p => ?_
  simp only [pb_STR02916, circDist_aff_STR02916 hσ]

theorem isC2Alpha_pb_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c : ℝ) {α : ℝ} {w : ℝ → ℝ}
    (hw : IsC2Alpha_STR02901 α w) : IsC2Alpha_STR02901 α (pb_STR02916 σ c w) := by
  obtain ⟨hper, hd, hd', hc, hh⟩ := hw
  have hdiff : ∀ g : ℝ → ℝ, Differentiable ℝ g → Differentiable ℝ (pb_STR02916 σ c g) :=
    fun g hg => hg.comp (by fun_prop)
  refine ⟨?_, hdiff w hd, ?_, ?_, ?_⟩
  · intro t
    show w (σ * (t + 2 * Real.pi) + c) = w (σ * t + c)
    rcases hσ with rfl | rfl
    · have h : (1 : ℝ) * (t + 2 * Real.pi) + c = (1 * t + c) + 2 * Real.pi := by ring
      rw [h]
      exact hper _
    · have h : (-1 : ℝ) * (t + 2 * Real.pi) + c = (-1 * t + c) - 2 * Real.pi := by ring
      rw [h]
      exact hper.sub_eq _
  · rw [deriv_pb_STR02916 hd]
    exact (hdiff _ hd').const_mul σ
  · rw [deriv2_pb_STR02916 hσ hd hd']
    exact hc.comp (by fun_prop)
  · rw [deriv2_pb_STR02916 hσ hd hd']
    obtain ⟨C, hC0, hC⟩ := hh
    refine ⟨C, hC0, fun s t => ?_⟩
    have h := hC (σ * s + c) (σ * t + c)
    rw [circDist_aff_STR02916 hσ] at h
    exact h

theorem c2Norm_pb_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c : ℝ) {α : ℝ} {w : ℝ → ℝ}
    (hw : IsC2Alpha_STR02901 α w) :
    c2Norm_STR02901 α (pb_STR02916 σ c w) = c2Norm_STR02901 α w := by
  obtain ⟨-, hd, hd', -, -⟩ := hw
  unfold c2Norm_STR02901
  rw [deriv2_pb_STR02916 hσ hd hd', deriv_pb_STR02916 hd, circHolder_pb_STR02916 hσ,
    supNorm_pb_STR02916 hσ, supNorm_sign_mul_STR02916 hσ, supNorm_pb_STR02916 hσ,
    supNorm_pb_STR02916 hσ]

theorem meanT_pb_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c : ℝ) {f : ℝ → ℝ}
    (hper : Function.Periodic f (2 * Real.pi)) :
    meanT_STR02901 (pb_STR02916 σ c f) = meanT_STR02901 f := by
  unfold meanT_STR02901
  congr 1
  unfold pb_STR02916
  rcases hσ with rfl | rfl
  · have h1 : ∫ x in (0 : ℝ)..2 * Real.pi, f (1 * x + c) =
        ∫ x in (0 : ℝ)..2 * Real.pi, f (x + c) := by simp
    rw [h1, intervalIntegral.integral_comp_add_right (fun x => f x) c]
    have h2 := hper.intervalIntegral_add_eq c 0
    rw [zero_add] at h2 ⊢
    rw [add_comm (2 * Real.pi) c]
    exact h2
  · have h1 : ∫ x in (0 : ℝ)..2 * Real.pi, f (-1 * x + c) =
        ∫ x in (0 : ℝ)..2 * Real.pi, f (c - x) := by
      congr 1
      funext x
      congr 1
      ring
    rw [h1, intervalIntegral.integral_comp_sub_left (fun x => f x) c]
    have h2 := hper.intervalIntegral_add_eq (c - 2 * Real.pi) 0
    rw [zero_add, sub_add_cancel] at h2
    rw [sub_zero]
    exact h2

theorem meanT_pb_trig_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c : ℝ) {w g : ℝ → ℝ}
    (hw : Continuous w) (hper : Function.Periodic w (2 * Real.pi)) (A B : ℝ)
    (hg : ∀ t, g t = A * Real.cos (σ * t + c) + B * Real.sin (σ * t + c)) :
    meanT_STR02901 (fun t => pb_STR02916 σ c w t * g t) =
      A * meanT_STR02901 (fun s => w s * Real.cos s) +
        B * meanT_STR02901 (fun s => w s * Real.sin s) := by
  have hF : (fun t => pb_STR02916 σ c w t * g t) = pb_STR02916 σ c
      (fun s => A * (w s * Real.cos s) + B * (w s * Real.sin s)) := by
    funext t
    simp only [pb_STR02916, hg t]
    ring
  have hlin := meanT_comb2_STR02950 (A := fun s => w s * Real.cos s)
    (B := fun s => w s * Real.sin s) (hw.mul Real.continuous_cos) (hw.mul Real.continuous_sin) A B
  rw [hF, meanT_pb_STR02916 hσ c]
  · exact hlin
  · intro s
    simp only [hper s, Real.cos_add_two_pi, Real.sin_add_two_pi]

theorem inE_pb_STR02916 {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (c : ℝ) {w : ℝ → ℝ}
    (hw : Continuous w) (hper : Function.Periodic w (2 * Real.pi)) (hE : InE_STR02901 w) :
    InE_STR02901 (pb_STR02916 σ c w) := by
  obtain ⟨h0, h1, h2⟩ := hE
  refine ⟨?_, ?_, ?_⟩
  · rw [meanT_pb_STR02916 hσ c hper]
    exact h0
  · have hcos : ∀ t, Real.cos t = Real.cos c * Real.cos (σ * t + c) +
        Real.sin c * Real.sin (σ * t + c) := by
      intro t
      have h : Real.cos t = Real.cos ((σ * t + c) - c) := by
        rcases hσ with rfl | rfl <;> simp
      rw [h, Real.cos_sub]
      ring
    rw [meanT_pb_trig_STR02916 hσ c hw hper (Real.cos c) (Real.sin c) hcos, h1, h2]
    ring
  · have hsin : ∀ t, Real.sin t = (-σ * Real.sin c) * Real.cos (σ * t + c) +
        (σ * Real.cos c) * Real.sin (σ * t + c) := by
      intro t
      have h : Real.sin t = σ * Real.sin ((σ * t + c) - c) := by
        rcases hσ with rfl | rfl <;> simp
      rw [h, Real.sin_sub]
      ring
    rw [meanT_pb_trig_STR02916 hσ c hw hper (-σ * Real.sin c) (σ * Real.cos c) hsin, h1, h2]
    ring

/-- The pullback `w ↦ w (σ · + c)` on `E`, for `σ = ±1`. With `σ = 1` it is the translation
`T_{-c}` (so `T_θ = pullE 1 _ (-θ)`), with `σ = -1`, `c = 0` it is the reflection. -/
noncomputable def pullE_STR02916 (σ : ℝ) (hσ : σ = 1 ∨ σ = -1) (c : ℝ) (w : E_STR02969) :
    E_STR02969 :=
  ⟨PeriodicC2_STR02969.mk (pb_STR02916 σ c (w : PeriodicC2_STR02969).val)
      (isC2Alpha_pb_STR02916 hσ c (w : PeriodicC2_STR02969).isC2),
    (c2Data_STR02969.mem_sub_iff _).mpr
      (inE_pb_STR02916 hσ c (w : PeriodicC2_STR02969).isC2.2.1.continuous
        (w : PeriodicC2_STR02969).isC2.1 ((c2Data_STR02969.mem_sub_iff _).mp w.2))⟩

theorem pullE_val_STR02916 (σ : ℝ) (hσ : σ = 1 ∨ σ = -1) (c : ℝ) (w : E_STR02969) (t : ℝ) :
    ((pullE_STR02916 σ hσ c w : E_STR02969) : PeriodicC2_STR02969).val t =
      (w : PeriodicC2_STR02969).val (σ * t + c) := rfl

theorem norm_pullE_STR02916 (σ : ℝ) (hσ : σ = 1 ∨ σ = -1) (c : ℝ) (w : E_STR02969) :
    ‖pullE_STR02916 σ hσ c w‖ = ‖w‖ :=
  c2Norm_pb_STR02916 hσ c (w : PeriodicC2_STR02969).isC2

/-! ### The symmetry actions on the parameter space -/

/-- The rotation of the `(a, b)`-plane induced by `T_θ`, `T_θ u (t) = u (t - θ)`. -/
noncomputable def rotPar_STR02916 (θ : ℝ) (p : Par_STR02916) : Par_STR02916 :=
  (p.1 * Real.cos θ - p.2.1 * Real.sin θ, p.1 * Real.sin θ + p.2.1 * Real.cos θ,
    p.2.2.1, p.2.2.2)

/-- The reflection `(a, b, h, γ) ↦ (a, -b, h, γ)` induced by `t ↦ -t`. -/
def reflPar_STR02916 (p : Par_STR02916) : Par_STR02916 := (p.1, -p.2.1, p.2.2.1, p.2.2.2)

/-- The sign symmetry `(a, b, h, γ) ↦ (-a, -b, -h, γ)` (the parameter part of `T_π`). -/
def signPar_STR02916 (p : Par_STR02916) : Par_STR02916 := (-p.1, -p.2.1, -p.2.2.1, p.2.2.2)

/-- The squared Euclidean norm on `ℝ⁴`. -/
def eucSq_STR02916 (p : Par_STR02916) : ℝ := p.1 ^ 2 + p.2.1 ^ 2 + p.2.2.1 ^ 2 + p.2.2.2 ^ 2

theorem eucSq_continuous_STR02916 : Continuous eucSq_STR02916 := by
  unfold eucSq_STR02916
  fun_prop

theorem eucSq_rot_STR02916 (θ : ℝ) (p : Par_STR02916) :
    eucSq_STR02916 (rotPar_STR02916 θ p) = eucSq_STR02916 p := by
  have h := Real.sin_sq_add_cos_sq θ
  unfold eucSq_STR02916 rotPar_STR02916
  calc (p.1 * Real.cos θ - p.2.1 * Real.sin θ) ^ 2 + (p.1 * Real.sin θ + p.2.1 * Real.cos θ) ^ 2 +
        p.2.2.1 ^ 2 + p.2.2.2 ^ 2
      = (p.1 ^ 2 + p.2.1 ^ 2) * (Real.sin θ ^ 2 + Real.cos θ ^ 2) + p.2.2.1 ^ 2 +
        p.2.2.2 ^ 2 := by ring
    _ = p.1 ^ 2 + p.2.1 ^ 2 + p.2.2.1 ^ 2 + p.2.2.2 ^ 2 := by rw [h]; ring

theorem eucSq_refl_STR02916 (p : Par_STR02916) :
    eucSq_STR02916 (reflPar_STR02916 p) = eucSq_STR02916 p := by
  unfold eucSq_STR02916 reflPar_STR02916
  ring

theorem eucSq_sign_STR02916 (p : Par_STR02916) :
    eucSq_STR02916 (signPar_STR02916 p) = eucSq_STR02916 p := by
  unfold eucSq_STR02916 signPar_STR02916
  ring

theorem norm_lt_of_eucSq_STR02916 {δ : ℝ} (hδ : 0 < δ) {p : Par_STR02916}
    (hp : eucSq_STR02916 p < δ ^ 2) : ‖p‖ < δ := by
  unfold eucSq_STR02916 at hp
  have h1 := sq_nonneg p.1
  have h2 := sq_nonneg p.2.1
  have h3 := sq_nonneg p.2.2.1
  have h4 := sq_nonneg p.2.2.2
  simp only [Prod.norm_def, Real.norm_eq_abs, max_lt_iff]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> exact abs_lt_of_sq_lt_sq (by linarith) hδ.le

/-! ### The main theorem -/

/-- STR029.16: unique smooth range graph. Near zero in `ℝ⁴ × E` the zero set of the variational
range map `R` is the graph of a smooth map `ψ`, with `ψ (0, 0, h, γ) = 0`, over neighborhoods that
are invariant under the symmetries used in STR029.21. -/
theorem str029_16_unique_smooth_range_graph :
    ∃ (U : Set Par_STR02916) (V : Set E_STR02969) (ψ : Par_STR02916 → E_STR02969),
      IsOpen U ∧ (0 : Par_STR02916) ∈ U ∧ IsOpen V ∧ (0 : E_STR02969) ∈ V ∧
      ContDiffOn ℝ ∞ ψ U ∧ ψ 0 = 0 ∧ (∀ p ∈ U, ψ p ∈ V) ∧
      (∀ p ∈ U, ∀ w ∈ V, Rpar_STR02916 p w = 0 ↔ w = ψ p) ∧
      (∀ h γ : ℝ, ((0, 0, h, γ) : Par_STR02916) ∈ U → ψ (0, 0, h, γ) = 0) ∧
      (∀ θ : ℝ, ∀ p ∈ U, rotPar_STR02916 θ p ∈ U) ∧
      (∀ p ∈ U, reflPar_STR02916 p ∈ U) ∧ (∀ p ∈ U, signPar_STR02916 p ∈ U) ∧
      (∀ (σ : ℝ) (hσ : σ = 1 ∨ σ = -1) (c : ℝ), ∀ w ∈ V, pullE_STR02916 σ hσ c w ∈ V) := by
  have : CompleteSpace E_STR02969 :=
    str029_69_completeness_closed_complements_range_spaces_E.2.2
  have : CompleteSpace Y_STR02969 :=
    str029_69_completeness_closed_complements_range_spaces_Y.2.2
  obtain ⟨U₀, N₀, ψ, hU₀, h0U₀, hN₀, h0N₀, hcd, hψ0, -, hiff⟩ :=
    implicit_graph_STR02916 Fp_smooth_STR02916 Fp_zero_STR02916 Fp_inv_STR02916
  obtain ⟨ε, hε, hεN⟩ := Metric.isOpen_iff.mp hN₀ 0 h0N₀
  have hcont : ContinuousAt ψ 0 := hcd.continuousOn.continuousAt (hU₀.mem_nhds h0U₀)
  have hW : U₀ ∩ ψ ⁻¹' Metric.ball (0 : E_STR02969) ε ∈ 𝓝 (0 : Par_STR02916) :=
    Filter.inter_mem (hU₀.mem_nhds h0U₀) (hcont.preimage_mem_nhds (by
      rw [hψ0]; exact Metric.ball_mem_nhds 0 hε))
  obtain ⟨δ, hδ, hδW⟩ := Metric.mem_nhds_iff.mp hW
  have hUW : ∀ p : Par_STR02916, eucSq_STR02916 p < δ ^ 2 →
      p ∈ U₀ ∧ ψ p ∈ Metric.ball (0 : E_STR02969) ε := fun p hp =>
    hδW (mem_ball_zero_iff.mpr (norm_lt_of_eucSq_STR02916 hδ hp))
  have h0euc : eucSq_STR02916 (0 : Par_STR02916) < δ ^ 2 := by
    have : eucSq_STR02916 (0 : Par_STR02916) = 0 := by simp [eucSq_STR02916]
    rw [this]; positivity
  refine ⟨{p | eucSq_STR02916 p < δ ^ 2}, Metric.ball 0 ε, ψ,
    isOpen_lt eucSq_continuous_STR02916 continuous_const, h0euc, Metric.isOpen_ball,
    Metric.mem_ball_self hε, hcd.mono fun p hp => (hUW p hp).1, hψ0,
    fun p hp => (hUW p hp).2, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro p hp w hw
    exact (hiff p (hUW p hp).1 w (hεN hw)).trans eq_comm
  · intro h γ hp
    have h1 := (hiff _ (hUW _ hp).1 0 h0N₀).mp (by
      have := Rpar_equilibrium_STR02916 h γ
      exact this)
    exact h1
  · intro θ p hp
    show eucSq_STR02916 (rotPar_STR02916 θ p) < δ ^ 2
    rw [eucSq_rot_STR02916]
    exact hp
  · intro p hp
    show eucSq_STR02916 (reflPar_STR02916 p) < δ ^ 2
    rw [eucSq_refl_STR02916]
    exact hp
  · intro p hp
    show eucSq_STR02916 (signPar_STR02916 p) < δ ^ 2
    rw [eucSq_sign_STR02916]
    exact hp
  · intro σ hσ c w hw
    rw [mem_ball_zero_iff] at hw ⊢
    rw [norm_pullE_STR02916]
    exact hw

