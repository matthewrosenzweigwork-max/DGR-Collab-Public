import FullLabeledLSI.Defs.F04_Reveal
import SharpSymmetricLSI.Defs.D09_ParticleRates
import FullLabeledLSI.Paper.Sec5Force

/-!
# S22: Lemma 5.5 (`lem:random-force`), the conditional force comparison

Manuscript Lemma 5.5, (5.14). Assume (1.2) and `r_* > 0`; `μ` is the equilibrium, `U_N` and `b` as in
Section 4. If `I` is uniform in `R`, `ℓ = N - M`, `M ≥ 3` and `M/N ≥ τ > 0`, then
`∑_{j<ℓ} E |B_S(X_I) - E_ν[∇_I U_N | X_S, X_I, S, I]|² ≤ C_τ (1 + √H_0)`.

Encodings: as in S21 (`ν` with smooth positive density, `H_0 = H(ν|μ^{⊗N}) < ⊤`, `C_τ` uniform in `N`,
`M`, `ν`). The expectation over `S` (uniform `j`-subset) and `I` (uniform in `R`) is written as an
explicit average; for fixed `S, I`, `E_ν[∇_I U_N | X_S, X_I]` is `condExp` for the σ-algebra generated
by `(X_S, X_I)`. `|·|²` is `∑_k (·)_k²`; `∇_I U_N` is `weakGradC (Ucentered W μ N) · I`.
-/

open MeasureTheory InformationTheory
open scoped ENNReal

namespace SharpLSI.FL

variable {d : ℕ}

/-- The σ-algebra generated by `(X_S, X_i)`. -/
def revealSigma {N : ℕ} (S : Finset (Fin N)) (i : Fin N) : MeasurableSpace (Config N d) :=
  MeasurableSpace.comap (fun X : Config N d => (restrictS S X, X i)) inferInstance

/-- `E |B_S(X_I) - E_ν[∇_I U_N | X_S, X_I]|²` at level `j`. -/
noncomputable def forceDefect {N : ℕ} (W : Torus d → Torus d → ℝ) (μ : Measure (Torus d))
    (ν : Measure (Config N d)) [IsFiniteMeasure ν] (j : ℕ) : ℝ :=
  ((Nat.choose N j : ℝ)⁻¹) * ∑ S ∈ (Finset.univ : Finset (Fin N)).powersetCard j,
    ((Sᶜ.card : ℝ)⁻¹) * ∑ i ∈ Sᶜ, ∫ X, ∑ k : Fin d,
      (condForceS W μ ν S X (X i) k -
        condExp (revealSigma S i) ν (fun Y => weakGradC (Ucentered W μ N) Y i k) X) ^ 2 ∂ν

/-- Lemma 5.5, (5.14). -/
theorem random_force {V : Torus d → ℝ} {W : Torus d → Torus d → ℝ} {KV KW : ℝ}
    (hd : 1 ≤ d) (hyp : Hyp V W KV KW) (hr : 0 < rStar V W)
    (μ : ProbabilityMeasure (Torus d)) (hμ : IsMinimizer V W μ) (τ : ℝ) (hτ : 0 < τ) :
    ∃ C : ℝ, ∀ (N M : ℕ), 3 ≤ M → M ≤ N → τ ≤ (M : ℝ) / N →
      ∀ (ν : Measure (Config N d)) [IsProbabilityMeasure ν], HasSmoothPosDensity ν →
        klDiv ν (Measure.pi fun _ => (μ : Measure (Torus d))) ≠ ⊤ →
        ∑ j ∈ Finset.range (N - M), forceDefect W (μ : Measure (Torus d)) ν j ≤
          C * (1 + Real.sqrt (klDiv ν (Measure.pi fun _ => (μ : Measure (Torus d)))).toReal) := by
  obtain ⟨C, hC⟩ := random_force_aux hd hyp hr μ hμ τ hτ
  refine ⟨C, fun N M h3 hMN hτM ν _ hν hH => ?_⟩
  exact hC N M h3 hMN hτM ν hν hH

end SharpLSI.FL
