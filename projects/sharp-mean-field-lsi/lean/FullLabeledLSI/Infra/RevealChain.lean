import FullLabeledLSI.Defs.F04_Reveal
import FullLabeledLSI.Infra.RevealCount
import FullLabeledLSI.Infra.RevealKL
import SharpSymmetricLSI.Paper.Sec5_2

/-!
# Section 5 infrastructure, part 3: conditional relative entropies along a tuple

For a probability `ν` on `(𝕋^d)^N`, a probability `μ` on `𝕋^d`, `S ⊆ Fin N` and labels `I`:
* `gRev ν μ S i = E H(ρ_{S,i} | μ)` (one summand of `h_j`, (5.7)),
* `GRev ν μ S I = E H(ν_{S,I} | μ^{⊗k})`,
* `DRev ν S I = E H(ν_{S,I} | ρ_{S,I_1} ⊗ ⋯ ⊗ ρ_{S,I_k})` (one summand of `d_{j,k}`, (5.8)).
Everything is an identity in `ℝ≥0∞`, without finiteness assumptions.
-/

open MeasureTheory ProbabilityTheory InformationTheory
open scoped ENNReal

namespace SharpLSI.FL

section Abstract

variable {Ω α α' β β₁ β₂ : Type*} [MeasurableSpace Ω] [MeasurableSpace α] [MeasurableSpace α']
  [MeasurableSpace β] [MeasurableSpace β₁] [MeasurableSpace β₂]
  [StandardBorelSpace β] [StandardBorelSpace β₁] [StandardBorelSpace β₂]
  [Nonempty β] [Nonempty β₁] [Nonempty β₂]

/-- Conditional distributions only depend on the σ-algebra generated by the conditioning variable:
if `Y` and `Y'` are measurable functions of each other, their conditional laws agree a.e. -/
theorem condDistrib_ae_eq_of_mutual (ν : Measure Ω) [IsProbabilityMeasure ν]
    {Y : Ω → α} {Y' : Ω → α'} (hY : Measurable Y) (hY' : Measurable Y')
    {f : α' → α} {f' : α → α'} (hf : Measurable f) (hf' : Measurable f')
    (h1 : ∀ ω, Y ω = f (Y' ω)) (h2 : ∀ ω, Y' ω = f' (Y ω)) {Z : Ω → β} (hZ : Measurable Z) :
    ∀ᵐ ω ∂ν, condDistrib Z Y ν (Y ω) = condDistrib Z Y' ν (Y' ω) := by
  let κ' : Kernel α' β := (condDistrib Z Y ν).comap f hf
  have key : ν.map (fun ω => (Y' ω, Z ω)) = ν.map Y' ⊗ₘ κ' := by
    ext s hs
    have hset : MeasurableSet (Prod.map f' (id : β → β) ⁻¹' s) :=
      (hf'.prodMap measurable_id) hs
    calc ν.map (fun ω => (Y' ω, Z ω)) s
        = ν.map (fun ω => (Y ω, Z ω)) (Prod.map f' id ⁻¹' s) := by
          rw [Measure.map_apply (hY'.prodMk hZ) hs, Measure.map_apply (hY.prodMk hZ) hset]
          congr 1
          ext ω
          simp [h2 ω]
      _ = (ν.map Y ⊗ₘ condDistrib Z Y ν) (Prod.map f' id ⁻¹' s) := by
          rw [compProd_map_condDistrib hY.aemeasurable hZ.aemeasurable]
      _ = ∫⁻ y, condDistrib Z Y ν y (Prod.mk y ⁻¹' (Prod.map f' id ⁻¹' s)) ∂ν.map Y :=
          Measure.compProd_apply hset
      _ = ∫⁻ ω, condDistrib Z Y ν (Y ω) (Prod.mk (Y ω) ⁻¹' (Prod.map f' id ⁻¹' s)) ∂ν :=
          lintegral_map (Kernel.measurable_kernel_prodMk_left hset) hY
      _ = ∫⁻ ω, κ' (Y' ω) (Prod.mk (Y' ω) ⁻¹' s) ∂ν := by
          refine lintegral_congr fun ω => ?_
          show _ = condDistrib Z Y ν (f (Y' ω)) _
          rw [← h1 ω]
          congr 1
          ext z
          simp [h2 ω]
      _ = ∫⁻ y', κ' y' (Prod.mk y' ⁻¹' s) ∂ν.map Y' :=
          (lintegral_map (Kernel.measurable_kernel_prodMk_left hs) hY').symm
      _ = (ν.map Y' ⊗ₘ κ') s := (Measure.compProd_apply hs).symm
  have h := condDistrib_ae_eq_of_measure_eq_compProd (μ := ν) hY'.aemeasurable hZ.aemeasurable key
  have h' := ae_of_ae_map hY'.aemeasurable h
  filter_upwards [h'] with ω hω
  rw [hω]
  show _ = condDistrib Z Y ν (f (Y' ω))
  rw [← h1 ω]

/-- Chain rule for the Kullback–Leibler divergence to a product reference on a product space,
with the first marginal. -/
theorem klDiv_prod_eq_add_fst {γ₁ γ₂ : Type*} [MeasurableSpace γ₁] [MeasurableSpace γ₂]
    [StandardBorelSpace γ₂] [Nonempty γ₂] (P : Measure (γ₁ × γ₂)) [IsProbabilityMeasure P]
    (μ₁ : Measure γ₁) (μ₂ : Measure γ₂) [IsProbabilityMeasure μ₁] [IsProbabilityMeasure μ₂] :
    klDiv P (μ₁.prod μ₂) = klDiv (P.map Prod.fst) μ₁ + klDiv P ((P.map Prod.fst).prod μ₂) := by
  have hP : P.fst ⊗ₘ P.condKernel = P := Measure.disintegrate P P.condKernel
  have h1 : P.fst ⊗ₘ P.condKernel = P := hP
  calc klDiv P (μ₁.prod μ₂)
      = klDiv (P.fst ⊗ₘ P.condKernel) (μ₁ ⊗ₘ Kernel.const γ₁ μ₂) := by
        rw [h1, Measure.compProd_const]
    _ = klDiv P.fst μ₁ + klDiv (P.fst ⊗ₘ P.condKernel) (P.fst ⊗ₘ Kernel.const γ₁ μ₂) :=
        klDiv_compProd_eq_add _ _ _ _
    _ = _ := by
        rw [h1, Measure.compProd_const]
        rfl

/-- Chain rule for a pair of conditioned variables, with the first conditional marginal as
reference for the second factor. -/
theorem lintegral_klDiv_condDistrib_pair_self (ν : Measure Ω) [IsProbabilityMeasure ν]
    {Y : Ω → α} {Z₁ : Ω → β₁} {Z₂ : Ω → β₂} (hY : Measurable Y) (hZ₁ : Measurable Z₁)
    (hZ₂ : Measurable Z₂) (μ₂ : Measure β₂) [IsProbabilityMeasure μ₂] :
    ∫⁻ ω, klDiv (condDistrib (fun ω => (Z₁ ω, Z₂ ω)) Y ν (Y ω))
        ((condDistrib Z₁ Y ν (Y ω)).prod μ₂) ∂ν =
      ∫⁻ ω, klDiv (condDistrib Z₂ (fun ω => (Y ω, Z₁ ω)) ν (Y ω, Z₁ ω)) μ₂ ∂ν := by
  let η : Kernel α (β₁ × β₂) := condDistrib Z₁ Y ν ×ₖ Kernel.const α μ₂
  have hη : ∀ a, η a = (condDistrib Z₁ Y ν a).prod μ₂ := fun a => by
    simp [η, Kernel.prod_apply]
  have hL : ∫⁻ ω, klDiv (condDistrib (fun ω => (Z₁ ω, Z₂ ω)) Y ν (Y ω))
        ((condDistrib Z₁ Y ν (Y ω)).prod μ₂) ∂ν =
      ∫⁻ a, klDiv (condDistrib (fun ω => (Z₁ ω, Z₂ ω)) Y ν a) (η a) ∂(ν.map Y) := by
    rw [lintegral_map (measurable_klDiv_kernel _ η) hY]
    simp only [hη]
  have hR : ∫⁻ ω, klDiv (condDistrib Z₂ (fun ω => (Y ω, Z₁ ω)) ν (Y ω, Z₁ ω)) μ₂ ∂ν =
      ∫⁻ b, klDiv (condDistrib Z₂ (fun ω => (Y ω, Z₁ ω)) ν b) ((Kernel.const _ μ₂) b)
        ∂(ν.map (fun ω => (Y ω, Z₁ ω))) := by
    rw [lintegral_map (measurable_klDiv_kernel _ (Kernel.const _ μ₂)) (hY.prodMk hZ₁)]
    rfl
  rw [hL, hR, ← klDiv_compProd_same_all, ← klDiv_compProd_same_all]
  have h1 : ν.map Y ⊗ₘ condDistrib (fun ω => (Z₁ ω, Z₂ ω)) Y ν =
      ν.map (fun ω => (Y ω, (Z₁ ω, Z₂ ω))) :=
    compProd_map_condDistrib hY.aemeasurable (hZ₁.prodMk hZ₂).aemeasurable
  have h2 : ν.map (fun ω => (Y ω, Z₁ ω)) ⊗ₘ condDistrib Z₂ (fun ω => (Y ω, Z₁ ω)) ν =
      ν.map (fun ω => ((Y ω, Z₁ ω), Z₂ ω)) :=
    compProd_map_condDistrib (hY.prodMk hZ₁).aemeasurable hZ₂.aemeasurable
  have h3 : (ν.map Y ⊗ₘ condDistrib (fun ω => (Z₁ ω, Z₂ ω)) Y ν).map
      (MeasurableEquiv.prodAssoc.symm : α × (β₁ × β₂) ≃ᵐ (α × β₁) × β₂) =
        ν.map (fun ω => (Y ω, Z₁ ω)) ⊗ₘ condDistrib Z₂ (fun ω => (Y ω, Z₁ ω)) ν := by
    rw [h1, h2, Measure.map_map (MeasurableEquiv.measurable _) (by fun_prop)]
    rfl
  have h4 : (ν.map Y ⊗ₘ η).map
      (MeasurableEquiv.prodAssoc.symm : α × (β₁ × β₂) ≃ᵐ (α × β₁) × β₂) =
        (ν.map (fun ω => (Y ω, Z₁ ω))).prod μ₂ := by
    refine (Measure.prod_eq fun s t hs ht => ?_).symm
    have hst : MeasurableSet (s ×ˢ t) := hs.prod ht
    have hm := (MeasurableEquiv.prodAssoc.symm : α × (β₁ × β₂) ≃ᵐ (α × β₁) × β₂).measurable
    rw [Measure.map_apply hm hst, Measure.compProd_apply (hm hst)]
    have hsec : ∀ a, Prod.mk a ⁻¹' ((MeasurableEquiv.prodAssoc.symm :
        α × (β₁ × β₂) ≃ᵐ (α × β₁) × β₂) ⁻¹' (s ×ˢ t)) = (Prod.mk a ⁻¹' s) ×ˢ t := by
      intro a
      ext ⟨b1, b2⟩
      show ((a, b1), b2) ∈ s ×ˢ t ↔ _
      simp
    simp_rw [hsec, hη, Measure.prod_prod]
    rw [lintegral_mul_const _ (Kernel.measurable_kernel_prodMk_left hs),
      ← compProd_map_condDistrib hY.aemeasurable hZ₁.aemeasurable, Measure.compProd_apply hs]
  rw [← klDiv_map_equiv' _ _ (MeasurableEquiv.prodAssoc.symm : α × (β₁ × β₂) ≃ᵐ (α × β₁) × β₂),
    h3, h4, Measure.compProd_const]

/-- Chain rule for the conditional relative entropy of a pair: conditioning on `Y`, then on
`(Y, Z₁)`. -/
theorem lintegral_klDiv_condDistrib_pair (ν : Measure Ω) [IsProbabilityMeasure ν]
    {Y : Ω → α} {Z₁ : Ω → β₁} {Z₂ : Ω → β₂} (hY : Measurable Y) (hZ₁ : Measurable Z₁)
    (hZ₂ : Measurable Z₂) (μ₁ : Measure β₁) (μ₂ : Measure β₂) [IsProbabilityMeasure μ₁]
    [IsProbabilityMeasure μ₂] :
    ∫⁻ ω, klDiv (condDistrib (fun ω => (Z₁ ω, Z₂ ω)) Y ν (Y ω)) (μ₁.prod μ₂) ∂ν =
      ∫⁻ ω, klDiv (condDistrib Z₁ Y ν (Y ω)) μ₁ ∂ν +
        ∫⁻ ω, klDiv (condDistrib Z₂ (fun ω => (Y ω, Z₁ ω)) ν (Y ω, Z₁ ω)) μ₂ ∂ν := by
  have hfst : ∀ᵐ ω ∂ν, (condDistrib (fun ω => (Z₁ ω, Z₂ ω)) Y ν (Y ω)).map Prod.fst =
      condDistrib Z₁ Y ν (Y ω) := by
    have h := condDistrib_comp (μ := ν) (X := Y) (Y := fun ω => (Z₁ ω, Z₂ ω))
      hY.aemeasurable (hZ₁.prodMk hZ₂).aemeasurable (f := Prod.fst) measurable_fst
    have h' := ae_of_ae_map hY.aemeasurable h
    filter_upwards [h'] with ω hω
    rw [Kernel.map_apply _ measurable_fst] at hω
    exact hω.symm
  have hmeas : Measurable fun ω => klDiv (condDistrib Z₁ Y ν (Y ω)) μ₁ :=
    (measurable_klDiv_kernel (condDistrib Z₁ Y ν) (Kernel.const _ μ₁)).comp hY
  calc ∫⁻ ω, klDiv (condDistrib (fun ω => (Z₁ ω, Z₂ ω)) Y ν (Y ω)) (μ₁.prod μ₂) ∂ν
      = ∫⁻ ω, (klDiv (condDistrib Z₁ Y ν (Y ω)) μ₁ +
          klDiv (condDistrib (fun ω => (Z₁ ω, Z₂ ω)) Y ν (Y ω))
            ((condDistrib Z₁ Y ν (Y ω)).prod μ₂)) ∂ν := by
        refine lintegral_congr_ae ?_
        filter_upwards [hfst] with ω hω
        rw [klDiv_prod_eq_add_fst _ μ₁ μ₂, hω]
    _ = _ := by
        rw [lintegral_add_left hmeas, lintegral_klDiv_condDistrib_pair_self ν hY hZ₁ hZ₂ μ₂]

/-- Conditioning on a variable with values in a subsingleton type is trivial. -/
theorem condDistrib_ae_eq_map_of_subsingleton (ν : Measure Ω) [IsProbabilityMeasure ν]
    [Subsingleton α] {Y : Ω → α} (hY : Measurable Y) {Z : Ω → β} (hZ : Measurable Z) :
    ∀ᵐ ω ∂ν, condDistrib Z Y ν (Y ω) = ν.map Z := by
  have key : ν.map (fun ω => (Y ω, Z ω)) = ν.map Y ⊗ₘ Kernel.const α (ν.map Z) := by
    rw [Measure.compProd_const]
    refine (Measure.prod_eq fun s t hs ht => ?_).symm
    rw [Measure.map_apply (hY.prodMk hZ) (hs.prod ht)]
    by_cases hne : s.Nonempty
    · obtain ⟨x, hx⟩ := hne
      have hs' : s = Set.univ := Set.eq_univ_of_forall fun y => by rwa [Subsingleton.elim y x]
      subst hs'
      rw [Measure.map_apply hY MeasurableSet.univ, Measure.map_apply hZ ht]
      have : (fun a => (Y a, Z a)) ⁻¹' (Set.univ ×ˢ t) = Z ⁻¹' t := by
        ext ω; simp
      simp [this]
    · rw [Set.not_nonempty_iff_eq_empty] at hne
      subst hne
      simp
  have h := condDistrib_ae_eq_of_measure_eq_compProd hY.aemeasurable hZ.aemeasurable key
  exact ae_of_ae_map hY.aemeasurable h

end Abstract

section Reveal

variable {d N : ℕ}

/-- `E H(ρ_{S,i} | μ)`. -/
noncomputable def gRev (ν : Measure (Config N d)) [IsFiniteMeasure ν] (μ : Measure (Torus d))
    (S : Finset (Fin N)) (i : Fin N) : ℝ≥0∞ :=
  ∫⁻ X, klDiv (condLawS ν S i (restrictS S X)) μ ∂ν

/-- `E H(ν_{S,I} | μ^{⊗k})`. -/
noncomputable def GRev (ν : Measure (Config N d)) [IsFiniteMeasure ν] (μ : Measure (Torus d))
    (S : Finset (Fin N)) {k : ℕ} (I : Fin k → Fin N) : ℝ≥0∞ :=
  ∫⁻ X, klDiv (condJointS ν S I (restrictS S X)) (Measure.pi fun _ : Fin k => μ) ∂ν

/-- `E H(ν_{S,I} | ρ_{S,I_1} ⊗ ⋯ ⊗ ρ_{S,I_k})`. -/
noncomputable def DRev (ν : Measure (Config N d)) [IsFiniteMeasure ν] (S : Finset (Fin N))
    {k : ℕ} (I : Fin k → Fin N) : ℝ≥0∞ :=
  ∫⁻ X, klDiv (condJointS ν S I (restrictS S X))
    (Measure.pi fun l => condLawS ν S (I l) (restrictS S X)) ∂ν

instance standardBorelSpace_torus_prod_chain (d : ℕ) :
    StandardBorelSpace (Torus d × Torus d) := by
  have : StandardBorelSpace (Torus d) := inferInstance
  infer_instance

instance isMarkovKernel_condLawS_chain (ν : Measure (Config N d)) [IsFiniteMeasure ν]
    (S : Finset (Fin N)) (i : Fin N) : IsMarkovKernel (condLawS ν S i) := by
  unfold condLawS; infer_instance

instance isMarkovKernel_condJointS_chain (ν : Measure (Config N d)) [IsFiniteMeasure ν]
    (S : Finset (Fin N)) {k : ℕ} (I : Fin k → Fin N) : IsMarkovKernel (condJointS ν S I) := by
  unfold condJointS; infer_instance

variable (ν : Measure (Config N d)) [IsProbabilityMeasure ν] (μ : Measure (Torus d))
  [IsProbabilityMeasure μ]

theorem measurable_restrictS (S : Finset (Fin N)) : Measurable (restrictS (d := d) S) :=
  measurable_pi_iff.mpr fun _ => measurable_pi_apply _

/-- The marginals of the joint conditional law are the individual conditional laws, a.e. -/
theorem condJointS_map_eval_ae (S : Finset (Fin N)) {k : ℕ} (I : Fin k → Fin N) (l : Fin k) :
    ∀ᵐ X ∂ν, (condJointS ν S I (restrictS S X)).map (fun x => x l) =
      condLawS ν S (I l) (restrictS S X) := by
  have h := condDistrib_comp (μ := ν) (X := restrictS S)
    (Y := fun X : Config N d => fun m => X (I m)) (measurable_restrictS S).aemeasurable
    (measurable_pi_iff.mpr fun m => measurable_pi_apply _).aemeasurable
    (f := fun x : Fin k → Torus d => x l) (measurable_pi_apply l)
  have h' := ae_of_ae_map (measurable_restrictS S).aemeasurable h
  filter_upwards [h'] with X hX
  rw [Kernel.map_apply _ (measurable_pi_apply l)] at hX
  exact hX.symm

theorem measurable_klDiv_condLawS (S : Finset (Fin N)) (i : Fin N) :
    Measurable fun X : Config N d => klDiv (condLawS ν S i (restrictS S X)) μ :=
  (measurable_klDiv_kernel (condLawS ν S i) (Kernel.const _ μ)).comp (measurable_restrictS S)

/-- The one-label case: `ν_{S,(i)}` is the pushforward of `ρ_{S,i}`; `GRev` with a single label is
`gRev`. -/
theorem GRev_one (S : Finset (Fin N)) (i : Fin N) :
    GRev ν μ S (fun _ : Fin 1 => i) = gRev ν μ S i := by
  let e := MeasurableEquiv.funUnique (Fin 1) (Torus d)
  have h := condDistrib_comp (μ := ν) (X := restrictS S) (Y := fun X : Config N d => X i)
    (measurable_restrictS S).aemeasurable (measurable_pi_apply i).aemeasurable
    (f := e.symm) e.symm.measurable
  have h' := ae_of_ae_map (measurable_restrictS S).aemeasurable h
  have hpi : Measure.pi (fun _ : Fin 1 => μ) = μ.map e.symm :=
    ((measurePreserving_funUnique μ (Fin 1)).symm e).map_eq.symm
  unfold GRev gRev
  refine lintegral_congr_ae ?_
  filter_upwards [h'] with X hX
  rw [Kernel.map_apply _ e.symm.measurable] at hX
  have : condJointS ν S (fun _ : Fin 1 => i) (restrictS S X) =
      (condLawS ν S i (restrictS S X)).map e.symm := hX
  rw [this, hpi]
  exact SharpLSI.klDiv_map_equiv' _ _ e.symm

/-- For `k ≤ 1`, `d_{j,k}` has no content. -/
theorem DRev_eq_zero_of_le_one_aux (S : Finset (Fin N)) {k : ℕ} (hk : k ≤ 1) (I : Fin k → Fin N) :
    DRev ν S I = 0 := by
  have hmarg : ∀ᵐ X ∂ν, ∀ l, (condJointS ν S I (restrictS S X)).map (fun x => x l) =
      condLawS ν S (I l) (restrictS S X) := ae_all_iff.2 fun l => condJointS_map_eval_ae ν S I l
  unfold DRev
  rw [← lintegral_zero (μ := ν)]
  refine lintegral_congr_ae ?_
  filter_upwards [hmarg] with X hX
  have : (fun l => condLawS ν S (I l) (restrictS S X)) =
      fun l => (condJointS ν S I (restrictS S X)).map (fun x => x l) := (funext hX).symm
  rw [this]
  exact klDiv_pi_marginals_of_le_one hk _

/-- Total-correlation decomposition (no distinctness needed). -/
theorem GRev_eq_DRev_add (S : Finset (Fin N)) {k : ℕ} (I : Fin k → Fin N) :
    GRev ν μ S I = DRev ν S I + ∑ l, gRev ν μ S (I l) := by
  have hmarg : ∀ᵐ X ∂ν, ∀ l, (condJointS ν S I (restrictS S X)).map (fun x => x l) =
      condLawS ν S (I l) (restrictS S X) := ae_all_iff.2 fun l => condJointS_map_eval_ae ν S I l
  have hg : Measurable fun X : Config N d => ∑ l, klDiv (condLawS ν S (I l) (restrictS S X)) μ :=
    Finset.measurable_sum _ fun l _ => measurable_klDiv_condLawS ν μ S (I l)
  have hae : ∀ᵐ X ∂ν, klDiv (condJointS ν S I (restrictS S X)) (Measure.pi fun _ : Fin k => μ) =
      klDiv (condJointS ν S I (restrictS S X))
        (Measure.pi fun l => condLawS ν S (I l) (restrictS S X)) +
      ∑ l, klDiv (condLawS ν S (I l) (restrictS S X)) μ := by
    filter_upwards [hmarg] with X hX
    rw [klDiv_pi_marginals (condJointS ν S I (restrictS S X)) (fun _ => μ)]
    have : (fun l => (condJointS ν S I (restrictS S X)).map fun x => x l) =
        fun l => condLawS ν S (I l) (restrictS S X) := funext hX
    rw [this]
    simp only [hX]
  unfold GRev DRev gRev
  rw [lintegral_congr_ae hae, lintegral_add_right _ hg,
    lintegral_finsetSum _ fun l _ => measurable_klDiv_condLawS ν μ S (I l)]

/-- `S ∪ {I_l : l < a}` membership. -/
theorem mem_preSet_iff {k : ℕ} (S : Finset (Fin N)) (J : Fin k → Fin N) (a : ℕ) (t : Fin N) :
    t ∈ preSet S J a ↔ t ∈ S ∨ ∃ l : Fin k, l.val < a ∧ J l = t := by
  simp [preSet]

theorem preSet_castSucc {k : ℕ} (S : Finset (Fin N)) (I : Fin (k + 1) → Fin N) (a : ℕ)
    (ha : a ≤ k) : preSet S I a = preSet S (I ∘ Fin.castSucc) a := by
  ext t
  rw [mem_preSet_iff, mem_preSet_iff]
  constructor
  · rintro (h | ⟨l, hl, rfl⟩)
    · exact Or.inl h
    · exact Or.inr ⟨⟨l.val, by omega⟩, hl, rfl⟩
  · rintro (h | ⟨l, hl, rfl⟩)
    · exact Or.inl h
    · exact Or.inr ⟨l.castSucc, hl, rfl⟩

/-- Conditioning on `(X_S, g(X))` instead of `X_T`, when the two σ-algebras agree. -/
theorem gRev_eq_of_mutual (S T : Finset (Fin N)) {γ : Type*} [MeasurableSpace γ]
    (g : Config N d → γ) (hg : Measurable g) (f : (T → Torus d) → (S → Torus d) × γ)
    (f' : (S → Torus d) × γ → (T → Torus d)) (hf : Measurable f) (hf' : Measurable f')
    (h1 : ∀ X, (restrictS S X, g X) = f (restrictS T X))
    (h2 : ∀ X, restrictS T X = f' (restrictS S X, g X)) (j : Fin N) :
    ∫⁻ ω, klDiv (condDistrib (fun X : Config N d => X j) (fun X => (restrictS S X, g X)) ν
      (restrictS S ω, g ω)) μ ∂ν = gRev ν μ T j := by
  have h := condDistrib_ae_eq_of_mutual ν (Y := fun X : Config N d => (restrictS S X, g X))
    (Y' := restrictS T) ((measurable_restrictS S).prodMk hg) (measurable_restrictS T) hf hf' h1 h2
    (Z := fun X : Config N d => X j) (measurable_pi_apply j)
  unfold gRev condLawS
  refine lintegral_congr_ae ?_
  filter_upwards [h] with ω hω
  exact congrArg (fun m => klDiv m μ) hω

/-- Reconstruct `X_T` from `(X_S, X_J)` for `T = preSet S J k`. -/
noncomputable def pairBack {k : ℕ} (S : Finset (Fin N)) (J : Fin k → Fin N)
    (y : (S → Torus d) × (Fin k → Torus d)) : (preSet S J k → Torus d) := fun t =>
  if h : (t : Fin N) ∈ S then y.1 ⟨t, h⟩
  else y.2 (Classical.choose (((mem_preSet_iff S J k t.1).1 t.2).resolve_left h))

theorem measurable_pairBack {k : ℕ} (S : Finset (Fin N)) (J : Fin k → Fin N) :
    Measurable (pairBack (d := d) S J) := by
  refine measurable_pi_iff.mpr fun t => ?_
  by_cases h : (t : Fin N) ∈ S
  · simp only [pairBack, dif_pos h]
    exact (measurable_pi_apply _).comp measurable_fst
  · simp only [pairBack, dif_neg h]
    exact (measurable_pi_apply _).comp measurable_snd

theorem gRev_eq_preSet {k : ℕ} (S : Finset (Fin N)) (J : Fin k → Fin N) (j : Fin N) :
    ∫⁻ ω, klDiv (condDistrib (fun X : Config N d => X j)
      (fun X => (restrictS S X, fun l => X (J l))) ν
      (restrictS S ω, fun l => ω (J l))) μ ∂ν = gRev ν μ (preSet S J k) j := by
  refine gRev_eq_of_mutual ν μ S (preSet S J k) (fun X l => X (J l))
    (measurable_pi_iff.mpr fun l => measurable_pi_apply _)
    (fun y' => (fun s => y' ⟨s.1, (mem_preSet_iff S J k s.1).2 (Or.inl s.2)⟩,
      fun l => y' ⟨J l, (mem_preSet_iff S J k (J l)).2 (Or.inr ⟨l, l.isLt, rfl⟩)⟩))
    (pairBack S J) ?_ (measurable_pairBack S J) (fun X => rfl) ?_ j
  · refine Measurable.prodMk (measurable_pi_iff.mpr fun s => measurable_pi_apply _)
      (measurable_pi_iff.mpr fun l => measurable_pi_apply _)
  · intro X
    funext t
    by_cases h : (t : Fin N) ∈ S
    · simp [pairBack, h, restrictS]
    · simp only [pairBack, dif_neg h]
      have := (Classical.choose_spec (((mem_preSet_iff S J k t.1).1 t.2).resolve_left h)).2
      simp only [restrictS]
      rw [this]

/-- One step of the chain rule. -/
theorem GRev_succ (S : Finset (Fin N)) {k : ℕ} (I : Fin (k + 1) → Fin N) :
    GRev ν μ S I = GRev ν μ S (I ∘ Fin.castSucc) +
      gRev ν μ (preSet S (I ∘ Fin.castSucc) k) (I (Fin.last k)) := by
  set e := initLast d k with he
  set J : Fin k → Fin N := I ∘ Fin.castSucc with hJ
  have hcomp : (fun X : Config N d => fun l : Fin (k + 1) => X (I l)) =
      e.symm ∘ (fun X : Config N d => ((fun l : Fin k => X (J l)), X (I (Fin.last k)))) := by
    funext X
    simp only [Function.comp_apply]
    rw [MeasurableEquiv.eq_symm_apply, he, initLast_apply]
    rfl
  have hZp : Measurable (fun X : Config N d => ((fun l : Fin k => X (J l)), X (I (Fin.last k)))) :=
    (measurable_pi_iff.mpr fun l => measurable_pi_apply _).prodMk (measurable_pi_apply _)
  have h := condDistrib_comp (μ := ν) (X := restrictS S) (measurable_restrictS S).aemeasurable
    hZp.aemeasurable (f := e.symm) e.symm.measurable
  have h' := ae_of_ae_map (measurable_restrictS S).aemeasurable h
  have hpi : Measure.pi (fun _ : Fin (k + 1) => μ) =
      ((Measure.pi fun _ : Fin k => μ).prod μ).map e.symm := by
    rw [← SharpLSI.map_initLast_pi μ k]
    exact (MeasurableEquiv.map_symm_map e).symm
  have hGR : GRev ν μ S I = ∫⁻ ω, klDiv (condDistrib (fun X : Config N d =>
      ((fun l : Fin k => X (J l)), X (I (Fin.last k)))) (restrictS S) ν (restrictS S ω))
      ((Measure.pi fun _ : Fin k => μ).prod μ) ∂ν := by
    unfold GRev
    refine lintegral_congr_ae ?_
    filter_upwards [h'] with X hX
    rw [Kernel.map_apply _ e.symm.measurable] at hX
    have : condJointS ν S I (restrictS S X) = (condDistrib (fun X : Config N d =>
        ((fun l : Fin k => X (J l)), X (I (Fin.last k)))) (restrictS S) ν
          (restrictS S X)).map e.symm := by
      rw [← hX]
      unfold condJointS
      rw [hcomp]
    rw [this, hpi]
    exact SharpLSI.klDiv_map_equiv' _ _ e.symm
  rw [hGR, lintegral_klDiv_condDistrib_pair ν (measurable_restrictS S)
    (Z₁ := fun X : Config N d => fun l : Fin k => X (J l))
    (Z₂ := fun X : Config N d => X (I (Fin.last k)))
    (measurable_pi_iff.mpr fun l => measurable_pi_apply _) (measurable_pi_apply _)
    (Measure.pi fun _ : Fin k => μ) μ, gRev_eq_preSet ν μ S J (I (Fin.last k))]
  rfl

/-- The chain rule along a tuple of labels (no distinctness needed). -/
theorem GRev_chain (S : Finset (Fin N)) {k : ℕ} (I : Fin k → Fin N) :
    GRev ν μ S I = ∑ a : Fin k, gRev ν μ (preSet S I a.val) (I a) := by
  induction k with
  | zero =>
    rw [GRev_eq_DRev_add ν μ S I, DRev_eq_zero_of_le_one_aux ν S (Nat.zero_le _) I]
    simp
  | succ k ih =>
    rw [GRev_succ ν μ S I, ih (I ∘ Fin.castSucc), Fin.sum_univ_castSucc]
    congr 1
    · refine Finset.sum_congr rfl fun a _ => ?_
      have ha := a.isLt
      simp only [Fin.val_castSucc]
      rw [preSet_castSucc S I a.val (by omega)]
      rfl
    · rw [Fin.val_last, preSet_castSucc S I k le_rfl]

/-- Conditioning on the empty set: the relative entropy of the law of `X ∘ I`. -/
theorem GRev_empty {k : ℕ} (I : Fin k → Fin N) :
    GRev ν μ ∅ I = klDiv (ν.map fun X => X ∘ I) (Measure.pi fun _ : Fin k => μ) := by
  have h := condDistrib_ae_eq_map_of_subsingleton ν
    (measurable_restrictS (d := d) (∅ : Finset (Fin N)))
    (Z := fun X : Config N d => fun l => X (I l))
    (measurable_pi_iff.mpr fun l => measurable_pi_apply _)
  unfold GRev
  rw [lintegral_congr_ae
    (g := fun _ => klDiv (ν.map fun X => X ∘ I) (Measure.pi fun _ : Fin k => μ)) ?_,
    lintegral_const, measure_univ, mul_one]
  filter_upwards [h] with X hX
  exact congrArg (fun m => klDiv m _) hX

/-- For a full ordering `σ`, `GRev ν μ ∅ σ = H(ν | μ^{⊗N})`. -/
theorem GRev_perm (σ : Equiv.Perm (Fin N)) :
    GRev ν μ ∅ (σ : Fin N → Fin N) = klDiv ν (Measure.pi fun _ : Fin N => μ) := by
  rw [GRev_empty]
  have hpi := SharpLSI.pi_map_perm μ σ
  have := SharpLSI.klDiv_map_equiv' ν (Measure.pi fun _ : Fin N => μ) (SharpLSI.permEquiv σ)
  rw [hpi] at this
  exact this

/-- For `k ≤ 1`, `d_{j,k}` has no content. -/
theorem DRev_eq_zero_of_le_one (S : Finset (Fin N)) {k : ℕ} (hk : k ≤ 1) (I : Fin k → Fin N) :
    DRev ν S I = 0 :=
  DRev_eq_zero_of_le_one_aux ν S hk I

/-- Conditional mutual information identity for two labels (no distinctness, no finiteness). -/
theorem DRev_pair_add (S : Finset (Fin N)) (i l : Fin N) :
    DRev ν S ![i, l] + gRev ν μ S l = gRev ν μ (insert i S) l := by
  have hR : gRev ν μ (insert i S) l = ∫⁻ ω, klDiv
      (condDistrib (fun X : Config N d => (X i, X l)) (restrictS S) ν (restrictS S ω))
      ((condDistrib (fun X : Config N d => X i) (restrictS S) ν (restrictS S ω)).prod μ) ∂ν := by
    rw [lintegral_klDiv_condDistrib_pair_self ν (measurable_restrictS S)
      (Z₁ := fun X : Config N d => X i) (Z₂ := fun X : Config N d => X l)
      (measurable_pi_apply i) (measurable_pi_apply l) μ]
    refine (gRev_eq_of_mutual ν μ S (insert i S) (fun X => X i) (measurable_pi_apply i)
      (fun y' => (fun s => y' ⟨s.1, Finset.mem_insert_of_mem s.2⟩,
        y' ⟨i, Finset.mem_insert_self i S⟩))
      (fun y t => if h : (t : Fin N) ∈ S then y.1 ⟨t, h⟩ else y.2) ?_ ?_ (fun X => rfl) ?_ l).symm
    · exact Measurable.prodMk (measurable_pi_iff.mpr fun s => measurable_pi_apply _)
        (measurable_pi_apply _)
    · refine measurable_pi_iff.mpr fun t => ?_
      by_cases h : (t : Fin N) ∈ S
      · simp only [dif_pos h]
        exact (measurable_pi_apply _).comp measurable_fst
      · simp only [dif_neg h]
        exact measurable_snd
    · intro X
      funext t
      by_cases h : (t : Fin N) ∈ S
      · simp [h, restrictS]
      · have ht : (t : Fin N) = i := by
          rcases Finset.mem_insert.1 t.2 with h' | h'
          · exact h'
          · exact absurd h' h
        simp only [dif_neg h, restrictS]
        rw [ht]
  have hmarg : ∀ᵐ X ∂ν, ∀ m : Fin 2,
      (condJointS ν S ![i, l] (restrictS S X)).map (fun x => x m) =
      condLawS ν S (![i, l] m) (restrictS S X) :=
    ae_all_iff.2 fun m => condJointS_map_eval_ae ν S ![i, l] m
  have hPe : ∀ᵐ X ∂ν, (condJointS ν S ![i, l] (restrictS S X)).map
      (MeasurableEquiv.piFinTwo fun _ : Fin 2 => Torus d) =
      condDistrib (fun X : Config N d => (X i, X l)) (restrictS S) ν (restrictS S X) := by
    have h := condDistrib_comp (μ := ν) (X := restrictS S)
      (Y := fun X : Config N d => fun m => X (![i, l] m)) (measurable_restrictS S).aemeasurable
      (measurable_pi_iff.mpr fun m => measurable_pi_apply _).aemeasurable
      (f := MeasurableEquiv.piFinTwo fun _ : Fin 2 => Torus d)
      (MeasurableEquiv.piFinTwo fun _ : Fin 2 => Torus d).measurable
    have h' := ae_of_ae_map (measurable_restrictS S).aemeasurable h
    filter_upwards [h'] with X hX
    rw [Kernel.map_apply _ (MeasurableEquiv.piFinTwo fun _ : Fin 2 => Torus d).measurable] at hX
    exact hX.symm
  have hmain : ∀ᵐ ω ∂ν, klDiv
      (condDistrib (fun X : Config N d => (X i, X l)) (restrictS S) ν (restrictS S ω))
      ((condDistrib (fun X : Config N d => X i) (restrictS S) ν (restrictS S ω)).prod μ) =
      klDiv (condJointS ν S ![i, l] (restrictS S ω))
        (Measure.pi fun m => condLawS ν S (![i, l] m) (restrictS S ω)) +
      klDiv (condLawS ν S l (restrictS S ω)) μ := by
    filter_upwards [hmarg, hPe] with ω hm hP
    set x := restrictS S ω with hx
    set P := condJointS ν S ![i, l] x with hPdef
    let Q : Fin 2 → Measure (Torus d) := ![condLawS ν S i x, μ]
    have hQ : ∀ m, IsProbabilityMeasure (Q m) := by
      refine Fin.forall_fin_two.2 ⟨?_, ?_⟩
      · show IsProbabilityMeasure (condLawS ν S i x)
        infer_instance
      · show IsProbabilityMeasure μ
        infer_instance
    haveI := hQ
    have hmp := (measurePreserving_piFinTwo Q).map_eq
    have h1 := klDiv_pi_marginals P Q
    have h2 : klDiv P (Measure.pi Q) =
        klDiv (condDistrib (fun X : Config N d => (X i, X l)) (restrictS S) ν x)
          ((condLawS ν S i x).prod μ) := by
      rw [← SharpLSI.klDiv_map_equiv' P (Measure.pi Q) (MeasurableEquiv.piFinTwo fun _ => Torus d),
        hP, hmp]
      rfl
    have h3 : (fun m => P.map (fun y => y m)) = fun m => condLawS ν S (![i, l] m) x := funext hm
    have h0 := hm 0
    have h1' := hm 1
    rw [Fin.sum_univ_two] at h1
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h0 h1'
    rw [h3, h0, h1'] at h1
    have h4 : klDiv (condDistrib (fun X : Config N d => (X i, X l)) (restrictS S) ν x)
        ((condLawS ν S i x).prod μ) = klDiv P (Measure.pi Q) := h2.symm
    rw [show (condDistrib (fun X : Config N d => X i) (restrictS S) ν x) = condLawS ν S i x from rfl,
      h4, h1]
    simp [Q]
  rw [hR]
  unfold DRev gRev
  rw [lintegral_congr_ae hmain, lintegral_add_right _ (measurable_klDiv_condLawS ν μ S l)]

end Reveal

