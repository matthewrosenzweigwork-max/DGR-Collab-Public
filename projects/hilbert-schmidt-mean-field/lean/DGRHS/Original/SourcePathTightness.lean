noncomputable section
open MeasureTheory Filter Topology Set
namespace DGRHS.Original

section Identification

variable {«𝒫» T : Type*} [mP : MeasurableSpace «𝒫»]

/-- Finite-dimensional evaluation map at a finite set of time/test indices. -/
def sourcePathFdd (X : T → «𝒫» → ℝ) (I : Finset T) : «𝒫» → (I → ℝ) :=
  fun ω => I.restrict (fun t => X t ω)

/-- Equal finite-dimensional distributions determine the law when the path
σ-algebra is generated by the evaluations (Kolmogorov uniqueness through
pinned `IsProjectiveLimit.unique`). -/
theorem sourcePath_law_eq_of_fdd_eq
    (X : T → «𝒫» → ℝ)
    (hgen : mP = MeasurableSpace.comap (fun ω => (fun t => X t ω)) MeasurableSpace.pi)
    (P Q : Measure «𝒫») [IsFiniteMeasure P] [IsFiniteMeasure Q]
    (hfdd : ∀ I : Finset T, P.map (sourcePathFdd X I) = Q.map (sourcePathFdd X I)) :
    P = Q := by
  have hev : Measurable (fun ω => (fun t => X t ω)) :=
    measurable_iff_comap_le.mpr hgen.symm.le
  have hP := ProbabilityTheory.isProjectiveLimit_map (X := X) (P := P) hev.aemeasurable
  have hQ := ProbabilityTheory.isProjectiveLimit_map (X := X) (P := Q) hev.aemeasurable
  have hP' : IsProjectiveLimit (P.map (fun ω => (fun t => X t ω)))
      (fun I => Q.map (fun ω => I.restrict (fun t => X t ω))) :=
    fun I => (hP I).trans (hfdd I)
  have hmap : P.map (fun ω => (fun t => X t ω)) = Q.map (fun ω => (fun t => X t ω)) :=
    hP'.unique hQ
  ext A hA
  rw [hgen] at hA
  obtain ⟨B, hB, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hA
  rw [← Measure.map_apply hev hB, ← Measure.map_apply hev hB, hmap]

/-- Measure-determining class (source wording): two probability laws on path space
with the same finite-dimensional laws coincide. -/
def SourcePathMeasureDetermining (X : T → «𝒫» → ℝ) : Prop :=
  ∀ P Q : ProbabilityMeasure «𝒫»,
    (∀ I : Finset T, P.map (sourcePathFdd X I) = Q.map (sourcePathFdd X I)) → P = Q

/-- Generating evaluations are measure determining. -/
theorem sourcePathMeasureDetermining_of_generate (X : T → «𝒫» → ℝ)
    (hgen : mP = MeasurableSpace.comap (fun ω => (fun t => X t ω)) MeasurableSpace.pi) :
    SourcePathMeasureDetermining X := by
  intro P Q h
  apply ProbabilityMeasure.toMeasure_injective
  refine sourcePath_law_eq_of_fdd_eq X hgen (P : Measure «𝒫») (Q : Measure «𝒫») (fun I => ?_)
  have h' := congrArg (fun m : ProbabilityMeasure (I → ℝ) => (m : Measure (I → ℝ))) (h I)
  simpa only [ProbabilityMeasure.toMeasure_map] using h'

/-- Concrete producer of the measure-determining premise: on a Polish path space
with its Borel σ-algebra, countably many continuous evaluations that separate
paths generate the Borel σ-algebra (Lusin–Souslin, pinned
`Continuous.measurableEmbedding`). -/
theorem sourcePath_generate_of_polish_separating
    [TopologicalSpace «𝒫»] [PolishSpace «𝒫»] [BorelSpace «𝒫»] [Countable T]
    (X : T → «𝒫» → ℝ) (hX : ∀ t, Continuous (X t))
    (hsep : ∀ ω ω' : «𝒫», (∀ t, X t ω = X t ω') → ω = ω') :
    mP = MeasurableSpace.comap (fun ω => (fun t => X t ω)) MeasurableSpace.pi := by
  have hc : Continuous (fun ω : «𝒫» => (fun t => X t ω)) := continuous_pi hX
  have hinj : Function.Injective (fun ω : «𝒫» => (fun t => X t ω)) := by
    intro ω ω' h
    exact hsep ω ω' (fun t => congrFun h t)
  have hemb : MeasurableEmbedding (fun ω : «𝒫» => (fun t => X t ω)) :=
    hc.measurableEmbedding hinj
  exact hemb.comap_eq.symm

end Identification

section Convergence

variable {«𝒫» T : Type*} [TopologicalSpace «𝒫»] [mP : MeasurableSpace «𝒫»] [BorelSpace «𝒫»]

/-- In a Hausdorff space a cluster point of a convergent map is its limit. -/
lemma sourcePath_eq_of_mapClusterPt_of_tendsto {α Y : Type*} [TopologicalSpace Y]
    [T2Space Y] {F : Filter α} {u : α → Y} {y z : Y}
    (hc : MapClusterPt y F u) (ht : Tendsto u F (𝓝 z)) : y = z := by
  have hc' : ClusterPt y (map u F) := hc
  exact eq_of_nhds_neBot (hc'.neBot.mono (inf_le_inf_left _ ht))

/-- Every subsequential (cluster) limit of the path laws has the finite-dimensional
laws of the target, hence equals the target law when the tests are measure
determining. This is the literal "every subsequential limit has the same law". -/
theorem sourcePath_clusterPt_eq
    (X : T → «𝒫» → ℝ) (hX : ∀ t, Continuous (X t))
    (hdet : SourcePathMeasureDetermining X)
    (μ : ℕ → ProbabilityMeasure «𝒫») (G : ProbabilityMeasure «𝒫»)
    (hfdd : ∀ I : Finset T,
      Tendsto (fun N => (μ N).map (sourcePathFdd X I)) atTop
        (𝓝 (G.map (sourcePathFdd X I))))
    (ν : ProbabilityMeasure «𝒫») (hν : MapClusterPt ν atTop μ) : ν = G := by
  apply hdet
  intro I
  have hcI : Continuous (sourcePathFdd X I) := by
    unfold sourcePathFdd
    exact continuous_pi (fun i => hX i)
  have hc := hν.continuousAt_comp
    ((ProbabilityMeasure.continuous_map hcI).continuousAt (x := ν))
  exact sourcePath_eq_of_mapClusterPt_of_tendsto hc (hfdd I)

/-- Historical compact-set form, kept for comparison: membership in one compact set
of laws plus fdd convergence gives convergence. -/
theorem sourcePath_tendsto_of_compact_of_fdd
    (X : T → «𝒫» → ℝ) (hX : ∀ t, Continuous (X t))
    (hdet : SourcePathMeasureDetermining X)
    (μ : ℕ → ProbabilityMeasure «𝒫») (K : Set (ProbabilityMeasure «𝒫»)) (hK : IsCompact K)
    (hmem : ∀ᶠ N in atTop, μ N ∈ K) (G : ProbabilityMeasure «𝒫»)
    (hfdd : ∀ I : Finset T,
      Tendsto (fun N => (μ N).map (sourcePathFdd X I)) atTop
        (𝓝 (G.map (sourcePathFdd X I)))) :
    Tendsto μ atTop (𝓝 G) :=
  hK.tendsto_nhds_of_unique_mapClusterPt hmem
    (fun ν _ hν => sourcePath_clusterPt_eq X hX hdet μ G hfdd ν hν)

/-- Prokhorov (pinned Mathlib): the source tightness of the sequence of path laws
makes the closure of the sequence compact in the topology of convergence in
distribution. -/
theorem sourcePath_isCompact_closure_range_of_isTight [T2Space «𝒫»]
    (μ : ℕ → ProbabilityMeasure «𝒫»)
    (htight : IsTightMeasureSet (Set.range fun N => (μ N : Measure «𝒫»))) :
    IsCompact (closure (Set.range μ)) := by
  apply isCompact_closure_of_isTightMeasureSet
  have hset : {x : Measure «𝒫» | ∃ ν : ProbabilityMeasure «𝒫», ν ∈ Set.range μ ∧ (ν : Measure «𝒫») = x}
      = Set.range fun N => (μ N : Measure «𝒫») := by
    ext m
    constructor
    · rintro ⟨ν, ⟨N, rfl⟩, rfl⟩
      exact ⟨N, rfl⟩
    · rintro ⟨N, rfl⟩
      exact ⟨μ N, ⟨N, rfl⟩, rfl⟩
  change IsTightMeasureSet
    {x : Measure «𝒫» | ∃ ν : ProbabilityMeasure «𝒫», ν ∈ Set.range μ ∧ (ν : Measure «𝒫») = x}
  rw [hset]
  exact htight

/-- **Conditional path-law convergence, source form (rem:pathSpaceCLT).**
Tightness of the path laws (source premise), measure-determining continuous
evaluations, and convergence of every finite-dimensional law to that of the
Gaussian path law `G` (whose existence on the path space is the source
trajectory-regularity premise) imply convergence of the FULL sequence of path laws
to `G`. -/
theorem sourcePath_tendsto_of_isTight_of_fdd [T2Space «𝒫»]
    (X : T → «𝒫» → ℝ) (hX : ∀ t, Continuous (X t))
    (hdet : SourcePathMeasureDetermining X)
    (μ : ℕ → ProbabilityMeasure «𝒫»)
    (htight : IsTightMeasureSet (Set.range fun N => (μ N : Measure «𝒫»)))
    (G : ProbabilityMeasure «𝒫»)
    (hfdd : ∀ I : Finset T,
      Tendsto (fun N => (μ N).map (sourcePathFdd X I)) atTop
        (𝓝 (G.map (sourcePathFdd X I)))) :
    Tendsto μ atTop (𝓝 G) :=
  sourcePath_tendsto_of_compact_of_fdd X hX hdet μ (closure (Set.range μ))
    (sourcePath_isCompact_closure_range_of_isTight μ htight)
    (Eventually.of_forall fun N => subset_closure (Set.mem_range_self N)) G hfdd

/-- Process identification: two path laws whose finite-dimensional laws are the
same prescribed (Gaussian) family coincide; so the path-space limit, if it exists,
is unique and is the Gaussian process of eq:dynamicFluctuationCovariance. -/
theorem sourcePath_gaussian_law_unique
    (X : T → «𝒫» → ℝ) (hdet : SourcePathMeasureDetermining X)
    (γ : ∀ I : Finset T, ProbabilityMeasure (I → ℝ))
    (G G' : ProbabilityMeasure «𝒫»)
    (hG : ∀ I, G.map (sourcePathFdd X I) = γ I)
    (hG' : ∀ I, G'.map (sourcePathFdd X I) = γ I) : G = G' :=
  hdet G G' (fun I => (hG I).trans (hG' I).symm)

/-- Full statement with the finite-dimensional limit given as the prescribed
Gaussian family `γ` (the conclusion of thm:dynamicLinearStatisticsCLT at each finite
set of time/test pairs) and the Gaussian path law `G` realizing `γ`. -/
theorem sourcePath_tendsto_of_isTight_of_gaussian_fdd [T2Space «𝒫»]
    (X : T → «𝒫» → ℝ) (hX : ∀ t, Continuous (X t))
    (hdet : SourcePathMeasureDetermining X)
    (μ : ℕ → ProbabilityMeasure «𝒫»)
    (htight : IsTightMeasureSet (Set.range fun N => (μ N : Measure «𝒫»)))
    (γ : ∀ I : Finset T, ProbabilityMeasure (I → ℝ))
    (hfdd : ∀ I : Finset T,
      Tendsto (fun N => (μ N).map (sourcePathFdd X I)) atTop (𝓝 (γ I)))
    (G : ProbabilityMeasure «𝒫») (hG : ∀ I, G.map (sourcePathFdd X I) = γ I) :
    Tendsto μ atTop (𝓝 G) := by
  refine sourcePath_tendsto_of_isTight_of_fdd X hX hdet μ htight G (fun I => ?_)
  rw [hG I]
  exact hfdd I

/-- Polish variant: the measure-determining premise is replaced by the concrete
separation of paths by countably many continuous evaluations, and is proved. -/
theorem sourcePath_tendsto_of_isTight_polish [T2Space «𝒫»] [PolishSpace «𝒫»] [Countable T]
    (X : T → «𝒫» → ℝ) (hX : ∀ t, Continuous (X t))
    (hsep : ∀ ω ω' : «𝒫», (∀ t, X t ω = X t ω') → ω = ω')
    (μ : ℕ → ProbabilityMeasure «𝒫»)
    (htight : IsTightMeasureSet (Set.range fun N => (μ N : Measure «𝒫»)))
    (γ : ∀ I : Finset T, ProbabilityMeasure (I → ℝ))
    (hfdd : ∀ I : Finset T,
      Tendsto (fun N => (μ N).map (sourcePathFdd X I)) atTop (𝓝 (γ I)))
    (G : ProbabilityMeasure «𝒫») (hG : ∀ I, G.map (sourcePathFdd X I) = γ I) :
    Tendsto μ atTop (𝓝 G) :=
  sourcePath_tendsto_of_isTight_of_gaussian_fdd X hX
    (sourcePathMeasureDetermining_of_generate X
      (sourcePath_generate_of_polish_separating X hX hsep))
    μ htight γ hfdd G hG

end Convergence

end DGRHS.Original
